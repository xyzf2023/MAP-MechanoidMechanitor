<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 为原版科技追加 MAP_MechHive 标签，使其被“新机械巢”玩家派系开局自动解锁 -->
  <!-- 复杂家具 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ResearchProjectDef[defName="ComplexFurniture"]/tags</xpath>
    <value><li>MAP_MechHive</li></value>
  </Operation>
  <!-- 岩石切割 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ResearchProjectDef[defName="Stonecutting"]/tags</xpath>
    <value><li>MAP_MechHive</li></value>
  </Operation>
  <!-- 微电子基础 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ResearchProjectDef[defName="MicroelectronicsBasics"]</xpath>
    <value><tags><li>MAP_MechHive</li></tags></value>
  </Operation>
  <!-- 机械加工 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ResearchProjectDef[defName="Machining"]</xpath>
    <value><tags><li>MAP_MechHive</li></tags></value>
  </Operation>
  <!-- 基础机械科技 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ResearchProjectDef[defName="BasicMechtech"]</xpath>
    <value><tags><li>MAP_MechHive</li></tags></value>
  </Operation>
  <!-- 太阳能板 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ResearchProjectDef[defName="SolarPanels"]</xpath>
    <value><tags><li>MAP_MechHive</li></tags></value>
  </Operation>
  <!-- 蓄电池 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ResearchProjectDef[defName="Batteries"]</xpath>
    <value><tags><li>MAP_MechHive</li></tags></value>
  </Operation>
</Patch>
