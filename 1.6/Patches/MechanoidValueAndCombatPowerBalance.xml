<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!--
    机械族经济价值与 Storyteller combatPower 平衡。
    自律指令核心已由 MAP_MechanoidMechanitorInstallableModuleBase 提供 MarketValue=5000，
    本文件无需重复覆盖。
  -->

  <!-- 隐者：MarketValue 800，combatPower 40 -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="MAP_Mech_Hermit"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>800</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="MAP_Mech_Hermit"]/combatPower</xpath>
    <value>
      <combatPower>40</combatPower>
    </value>
  </Operation>

  <!-- 恋人：MarketValue 1000，combatPower 60 -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="MAP_Mech_Lover"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>1000</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="MAP_Mech_Lover"]/combatPower</xpath>
    <value>
      <combatPower>60</combatPower>
    </value>
  </Operation>

  <!-- 月亮：MarketValue 1350，combatPower 225 -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="MAP_Mech_Moon"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>1350</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="MAP_Mech_Moon"]/combatPower</xpath>
    <value>
      <combatPower>225</combatPower>
    </value>
  </Operation>

  <!--
    普通正义当前从 MAP_JusticeBase 继承 MarketValue=8000 / combatPower=600。
    仅为普通 MAP_Mech_Justice 添加显式覆盖，避免影响同样继承该基类的 MAP_Mech_JusticeBOSS。
  -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="MAP_Mech_Justice"]/statBases</xpath>
    <value>
      <MarketValue>6000</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/PawnKindDef[defName="MAP_Mech_Justice"]</xpath>
    <value>
      <combatPower>625</combatPower>
    </value>
  </Operation>

</Patch>
