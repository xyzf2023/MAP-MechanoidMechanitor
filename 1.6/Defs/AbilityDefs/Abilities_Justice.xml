<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <AbilityDef>
    <defName>MAP_Ability_MechRecode</defName>
    <label>机体再编码</label>
    <description>尝试修改敌方机械体尸体的敌我识别系统，使该机械体尸体的阵营变成我方。仅可选择敌方机械体尸体作为目标。</description>
    <iconPath>UI/Abilities/MM_MechRecode</iconPath>
    <jobDef>MAP_Job_MechRecode</jobDef>
    <hasExternallyHandledCooldown>true</hasExternallyHandledCooldown>
    <canUseAoeToGetTargets>false</canUseAoeToGetTargets>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <drawAimPie>false</drawAimPie>
      <range>999</range>
      <warmupTime>0</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
        <canTargetCorpses>true</canTargetCorpses>
        <onlyTargetCorpses>true</onlyTargetCorpses>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MAP_MechanoidMechanitor.CompProperties_AbilityMechRecode">
        <recodeTicksPerBandwidth>300</recodeTicksPerBandwidth>
        <cooldownTicksPerBandwidth>18000</cooldownTicksPerBandwidth>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>MAP_Ability_MechReconstruction</defName>
    <label>机体重构</label>
    <description>尝试修复友方机械体尸体的全部损伤并将其重新启动。</description>
    <iconPath>UI/Abilities/MM_MechReconstruction</iconPath>
    <cooldownTicksRange>240000~240000</cooldownTicksRange>
    <warmupStartSound>MechResurrect_Warmup</warmupStartSound>
    <warmupEffecter>ApocrionAoeWarmup</warmupEffecter>
    <useAverageTargetPositionForWarmupEffecter>true</useAverageTargetPositionForWarmupEffecter>
    <jobDef>MAP_Job_MechReconstruction</jobDef>
    <canUseAoeToGetTargets>false</canUseAoeToGetTargets>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <drawAimPie>false</drawAimPie>
      <range>999</range>
      <warmupTime>2</warmupTime>
      <soundCast>MechResurrect_Cast</soundCast>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
        <canTargetCorpses>true</canTargetCorpses>
        <onlyTargetCorpses>true</onlyTargetCorpses>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MAP_MechanoidMechanitor.CompProperties_AbilityMechReconstruction">
        <invalidTargetMessageKey>MAP_MechanoidMechanitor.Justice.Ability.MechReconstruction.InvalidTarget</invalidTargetMessageKey>
        <reconstructionDurationTicks>900</reconstructionDurationTicks>
        <appliedEffecterDef>MechResurrected</appliedEffecterDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>MAP_Ability_MechHack</defName>
    <label>机体骇入</label>
    <description>尝试骇入一台非我方机械体。将一台目标内的非我方存活机械体的阵营改为我方。</description>
    <iconPath>UI/Abilities/MM_MechHack</iconPath>
    <cooldownTicksRange>300000~300000</cooldownTicksRange>
    <jobDef>MAP_Job_MechHack</jobDef>
    <hasExternallyHandledCooldown>true</hasExternallyHandledCooldown>
    <canUseAoeToGetTargets>false</canUseAoeToGetTargets>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <drawAimPie>false</drawAimPie>
      <range>999</range>
      <warmupTime>0</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
        <canTargetCorpses>false</canTargetCorpses>
        <onlyTargetCorpses>false</onlyTargetCorpses>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MAP_MechanoidMechanitor.CompProperties_AbilityMechHack">
        <invalidTargetMessageKey>MAP_MechanoidMechanitor.Justice.Ability.MechHack.InvalidTarget</invalidTargetMessageKey>
        <bossRestrictedTargetMessageKey>MAP_MechanoidMechanitor.Justice.Ability.MechHack.BossRestrictedTarget</bossRestrictedTargetMessageKey>
        <nonHostileConfirmMessageKey>MAP_MechanoidMechanitor.Justice.Ability.MechHack.NonHostileConfirm</nonHostileConfirmMessageKey>
        <hackDurationTicks>900</hackDurationTicks>
        <cooldownTicks>300000</cooldownTicks>
      </li>
    </comps>
  </AbilityDef>
</Defs>
