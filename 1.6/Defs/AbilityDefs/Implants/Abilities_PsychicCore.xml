<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <AbilityDef MayRequire="ludeon.rimworld.biotech,ludeon.rimworld.royalty">
    <defName>MAP_PsychicActivation</defName>
    <label>心灵活化</label>
    <description>主动激发心灵中枢，使灵能通路在短时间内进入高度活跃状态。\n持续期间使用者的灵能将得到进一步强化，并获得额外的精神力恢复能力。\n额外恢复效果随心灵中枢等级提升而提升。效果持续六个小时。</description>
    <iconPath>UI/Abilities/MM_PsychicActivation</iconPath>
    <cooldownTicksRange>180000~180000</cooldownTicksRange>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <showWhenDrafted>true</showWhenDrafted>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <canUseAoeToGetTargets>false</canUseAoeToGetTargets>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0</warmupTime>
      <range>-1</range>
      <drawAimPie>false</drawAimPie>
      <onlyManualCast>true</onlyManualCast>
      <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityEffect">
        <compClass>MAP_MechanoidMechanitor.CompAbilityEffect_PsychicCoreActivation</compClass>
      </li>
    </comps>
  </AbilityDef>
</Defs>
