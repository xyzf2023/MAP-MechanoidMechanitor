<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <WorldObjectDef>
    <defName>MAP_FactionOutpost</defName>
    <label>派系前哨</label>
    <worldObjectClass>MAP_MechanoidMechanitor.Scenarios.MAPFactionOutpost</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <expandingIcon>true</expandingIcon>
    <expandingIconPriority>65</expandingIconPriority>
    <selectable>true</selectable>
    <comps>
      <li Class="WorldObjectCompProperties_FormCaravan" />
    </comps>
    <IncidentTargetTags>
      <li>Map_Misc</li>
    </IncidentTargetTags>
    <inspectorTabs>
      <li>WITab_Terrain</li>
      <li>WITab_Planet</li>
    </inspectorTabs>
  </WorldObjectDef>

  <SitePartDef>
    <defName>MAP_FactionOutpost_Building</defName>
    <label>派系前哨（建设中）</label>
    <description>一个正在建设中的派系军事前哨。防御工事尚不完善，但已经部署了守军。</description>
    <siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
    <workerClass>MAP_MechanoidMechanitor.Scenarios.SitePartWorker_FactionOutpost</workerClass>
    <wantsThreatPoints>false</wantsThreatPoints>
    <considerEnteringAsAttack>true</considerEnteringAsAttack>
    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <showFactionInInspectString>true</showFactionInInspectString>
  </SitePartDef>

  <SitePartDef>
    <defName>MAP_FactionOutpost_Completed</defName>
    <label>派系前哨</label>
    <description>一处建设完成的派系军事前哨，部署了完整守军与防御工事。</description>
    <siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
    <workerClass>MAP_MechanoidMechanitor.Scenarios.SitePartWorker_FactionOutpost</workerClass>
    <wantsThreatPoints>false</wantsThreatPoints>
    <considerEnteringAsAttack>true</considerEnteringAsAttack>
    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <showFactionInInspectString>true</showFactionInInspectString>
  </SitePartDef>
</Defs>
