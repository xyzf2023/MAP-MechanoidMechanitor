<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 据点专用场景建筑，不与玩家方太阳建筑形态共用。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MAP_Building_SunBOSS</defName>
    <label>核心反应堆？</label>
    <description>这个建筑看起来是此设施的能源来源......但总感觉哪里不对劲。小心行事。</description>
    <thingClass>Building</thingClass>
    <tickerType>Never</tickerType>
    <!-- 苏醒时由组件接管整机绘制，避免静态地图网格残留闭合外壳。 -->
    <drawerType>RealtimeOnly</drawerType>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <useHitPoints>false</useHitPoints>
    <destroyable>true</destroyable>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <graphicData>
      <texPath>Mech/SunAncient/SunAncient_Building</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- 与太阳建筑形态使用相同的透明边距补偿，主体贴近 3 格占地。 -->
      <drawSize>(5.1,5.1)</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="MAP_MechanoidMechanitor.CompProperties_SunBossInspection">
        <ticksToActivate>900</ticksToActivate>
        <activateTexPath>UI/Commands/Inspect</activateTexPath>
        <activateLabelString>检查...</activateLabelString>
        <activateDescString>派一名殖民者或机械族机械师靠近并检查这座反应堆，确认异常能源反应的来源。</activateDescString>
        <guiLabelString>选择执行检查的殖民者或机械族机械师</guiLabelString>
        <jobString>检查反应堆</jobString>
        <activatingStringPending>正在检查反应堆</activatingStringPending>
        <activatingString>正在检查反应堆：{1}秒</activatingString>
        <showMustBeActivatedByColonist>false</showMustBeActivatedByColonist>
        <ignoreForbidden>true</ignoreForbidden>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_SunBuildingLight">
        <ancient>true</ancient>
      </li>
    </comps>
    <building>
      <neverBuildable>true</neverBuildable>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <repairable>false</repairable>
      <canBeDamagedByAttacks>false</canBeDamagedByAttacks>
      <allowAutoroof>false</allowAutoroof>
    </building>
  </ThingDef>
</Defs>
