<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 玩家太阳的建筑形态；与据点核心 MAP_Building_SunBOSS 独立。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MAP_Building_Sun</defName>
    <label>「太阳」（反应堆）</label>
    <description>TODO</description>
    <thingClass>Verse.Building</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <passability>Impassable</passability>
    <!-- 保留空气交换区域，供原版产热组件从 3x3 中心格向房间传热。 -->
    <fillPercent>0.8</fillPercent>
    <!-- 允许视线和射击越过；保留非全遮挡以保证中心格产热。 -->
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <graphicData>
      <texPath>Mech/Sun/Sun_Building</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>10000</MaxHitPoints>
      <WorkToBuild>60000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <designationCategory>Biotech</designationCategory>
    <costList>
      <MAP_AntimatterContainmentDevice>1</MAP_AntimatterContainmentDevice>
      <SubcoreHigh>1</SubcoreHigh>
      <Plasteel>600</Plasteel>
      <Steel>1500</Steel>
      <Uranium>300</Uranium>
      <ComponentSpacer>25</ComponentSpacer>
      <ComponentIndustrial>30</ComponentIndustrial>
      <Gold>50</Gold>
    </costList>
    <researchPrerequisites>
      <li>MAP_AntiparticleApplications</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    <building>
      <buildingTags>
        <li>Biotech</li>
      </buildingTags>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <repairable>true</repairable>
      <allowAutoroof>false</allowAutoroof>
    </building>
    <comps>
      <li Class="MAP_MechanoidMechanitor.CompProperties_SunEnergyAura">
        <buildingForm>true</buildingForm>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_MechFormCarrier" />
      <li Class="MAP_MechanoidMechanitor.CompProperties_MechBuildingForm">
        <constructedPawnKind>MAP_Mech_Sun</constructedPawnKind>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-800000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <!-- 产热组件 -->
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>200</heatPerSecond>
        <heatPushMaxTemperature>300</heatPushMaxTemperature>
      </li>
    </comps>
  </ThingDef>
</Defs>
