<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="MechGestatorBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MAP_MassProductionMechGestator</defName>
    <label>量产型机械培育仓</label>
    <description>使用超凡科技铸造而成的机械族培育仓，是主脑快速培育规模化机械部队的关键设施。\n\n该培育仓的培育时间固定为6小时，且培育完成后自动释放其中机械族。同时该培育仓可以培育所有已解锁配方的机械族。</description>
    <thingClass>MAP_MechanoidMechanitor.Building_MassProductionMechGestator</thingClass>
    <graphicData>
      <texPath>Buildings/MassProductionMechGestator</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(7,7)</drawSize>
      <shadowData>
        <volume>(2.4, 2.2, 2.1)</volume>
      </shadowData>
      <drawOffsetNorth>(0, 0.01, 1.0)</drawOffsetNorth>
      <drawOffsetEast>(0, 0.3, 1.0)</drawOffsetEast>
      <drawOffsetSouth>(0, 0.3, 1.0)</drawOffsetSouth>
      <drawOffsetWest>(0, 0.3, 1.0)</drawOffsetWest>
    </graphicData>
    <uiIconPath>Buildings/MassProductionMechGestator_south</uiIconPath>
    <uiIconScale>1.85</uiIconScale>
    <interactionCellOffset>(0,0,2)</interactionCellOffset>
    <placeWorkers Inherit="False" />
    <recipes>
      <li>Militor</li>
      <li>Lifter</li>
      <li>Constructoid</li>
      <li>Agrihand</li>
      <li>Cleansweeper</li>
      <li>Fabricor</li>
      <li>Paramedic</li>
      <li>ResurrectLightMech</li>
      <li>ResurrectMediumMech</li>
      <li>ResurrectHeavyMech</li>
      <li>ResurrectUltraheavyMech</li>
    </recipes>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <Steel>500</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ComponentSpacer>5</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>UltraMechtech</li>
    </researchPrerequisites>
    <building>
      <barDrawData>
        <north>
          <preRotationOffset>(-1.06, 0.91)</preRotationOffset>
          <size>(0, 0)</size>
        </north>
        <south>
          <preRotationOffset>(-1.06, 0.82)</preRotationOffset>
          <size>(0, 0)</size>
        </south>
        <east>
          <preRotationOffset>(1.06, -0.97)</preRotationOffset>
          <size>(0, 0)</size>
        </east>
        <west>
          <preRotationOffset>(-1.06, -0.97)</preRotationOffset>
          <size>(0, 0)</size>
        </west>
      </barDrawData>
      <formingGraphicData>
        <texPath>Things/Pawn/Mechanoid/HalfGestatedMechSmall</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(1,1)</drawSize>
      </formingGraphicData>
      <formingMechPerRotationOffset>
        <li>(0, 0, 0.45)</li>
        <li>(0, 0, 0.45)</li>
        <li>(0, 0, 0.45)</li>
        <li>(0, 0, 0.45)</li>
      </formingMechPerRotationOffset>
      <mechGestatorCylinderGraphic>
        <texPath>Buildings/TransparentGestatorTop</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1,1)</drawSize>
        <shaderType>Transparent</shaderType>
      </mechGestatorCylinderGraphic>
      <mechGestatorTopGraphic>
        <texPath>Buildings/TransparentGestatorTop</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1,1)</drawSize>
        <shaderType>Transparent</shaderType>
      </mechGestatorTopGraphic>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>350</basePowerConsumption>
        <idlePowerDraw>50</idlePowerDraw>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_MassProductionMechGestator" />
    </comps>
  </ThingDef>

</Defs>
