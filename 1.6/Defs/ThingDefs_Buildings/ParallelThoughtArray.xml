<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 并行思维阵列 -->
  <ThingDef ParentName="BuildingBase" MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_ParallelThoughtArray</defName>
    <label>并行思维阵列</label>
    <description>一座由大量量子运算模块组成的外置思维设施。阵列能够与指定机械师建立持续同步连接，在外部并行处理其意识活动与控制数据，并将运算结果实时反馈给目标。\n\n对机械族机械师而言，这会增加其可用于分配的数据处理能力；对安装了并行思维接口的人类机械师而言，则会直接提升其意识。提高阵列的运算强度会同时提高增幅效果与电力消耗。</description>
    <graphicData>
      <texPath>Things/Building/Misc/BandNode</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <shadowData>
        <volume>(1.5,0.35,1.2)</volume>
        <offset>(0,0,-0.15)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.7</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    <designationCategory>Biotech</designationCategory>
    <uiOrder>2485</uiOrder>
    <building>
      <buildingTags>
        <li>Biotech</li>
      </buildingTags>
    </building>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>30000</WorkToBuild>
      <Mass>300</Mass>
      <Flammability>0.3</Flammability>
    </statBases>
    <costList>
      <Steel>500</Steel>
      <Plasteel>250</Plasteel>
      <Gold>50</Gold>
      <ComponentSpacer>12</ComponentSpacer>
      <MAP_QuantumComputingChip>2</MAP_QuantumComputingChip>
    </costList>
    <researchPrerequisites>
      <li>MAP_ParallelThoughtMatrix</li>
    </researchPrerequisites>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <killedLeavings>
      <ChunkSlagSteel>5</ChunkSlagSteel>
    </killedLeavings>
    <filthLeaving>Filth_MachineBits</filthLeaving>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1000</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_ParallelThoughtArray">
        <minBoostPercent>100</minBoostPercent>
        <!-- 仅作为 int 存档安全护栏；不是面向玩家的平衡上限。 -->
        <maxBoostPercent>2147483600</maxBoostPercent>
        <boostStepPercent>50</boostStepPercent>
        <shiftBoostPercent>100</shiftBoostPercent>
        <controlBoostPercent>1000</controlBoostPercent>

        <basePowerConsumption>1000</basePowerConsumption>
        <powerPerBoostStep>600</powerPerBoostStep>
        <maxPowerPerBoostStep>12000</maxPowerPerBoostStep>
        <idlePowerConsumption>100</idlePowerConsumption>

        <lowLoadStepCount>16</lowLoadStepCount>
        <standardLoadEndStep>96</standardLoadEndStep>
        <fallbackRefreshIntervalTicks>60</fallbackRefreshIntervalTicks>
      </li>
    </comps>
  </ThingDef>

</Defs>
