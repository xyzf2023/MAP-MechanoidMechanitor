<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <MAP_MechanoidMechanitor.StoryThemeDef>
    <defName>MAP_Theme_MechanicalEcho</defName>
    <label>机械回响</label>
    <description>远方的机械信号正在汇聚，沉寂的战争机器回应着彼此的呼唤。与机械族有关的事件将更容易触发。</description>
    <themePoolTag>MAP_WheelOfFate</themePoolTag>
    <selectionWeight>1</selectionWeight>
    <!-- 对齐原版机械族正常袭击的最早天数，避免开局抽到几乎没有内容的机械主题。 -->
    <minDaysPassed>45</minDaysPassed>
    <durationDays>5~10</durationDays>
    <incidentIntervalFactor>0.9</incidentIntervalFactor>
    <letterDef>ThreatSmall</letterDef>

    <categoryWeightFactors>
      <ThreatBig>1.5</ThreatBig>
      <ThreatSmall>0.8</ThreatSmall>
    </categoryWeightFactors>
    <incidentWeightRules>
      <li><incident>DefoliatorShipPartCrash</incident><factor>3</factor></li>
      <li><incident>PsychicEmanatorShipPartCrash</incident><factor>3</factor></li>
      <li MayRequire="Ludeon.RimWorld.Royalty"><incident>MechCluster</incident><factor>4</factor></li>
      <li><incident>RaidEnemy</incident><factor>1.25</factor></li>
      <li><incident>Infestation</incident><factor>0.7</factor></li>
      <li><incident>ManhunterPack</incident><factor>0.7</factor></li>
    </incidentWeightRules>
    <raidFactionWeightFactors>
      <li>
        <factionDef>Mechanoid</factionDef>
        <factor>4</factor>
      </li>
    </raidFactionWeightFactors>
  </MAP_MechanoidMechanitor.StoryThemeDef>
</Defs>
