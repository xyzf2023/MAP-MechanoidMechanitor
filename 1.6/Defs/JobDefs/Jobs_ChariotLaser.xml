<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <JobDef>
    <defName>MAP_ChariotTrackingLaser</defName>
    <driverClass>MAP_MechanoidMechanitor.JobDriver_ChariotTrackingLaser</driverClass>
    <reportString>firing a tracking laser.</reportString>
    <playerInterruptible>true</playerInterruptible>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
    <suspendable>false</suspendable>
