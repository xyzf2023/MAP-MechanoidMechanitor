    <suspendable>false</suspendable>
    <sleepCanInterrupt>false</sleepCanInterrupt>
    <neverFleeFromEnemies>true</neverFleeFromEnemies>
    <neverShowWeapon>true</neverShowWeapon>
    <ifFlyingKeepFlying>true</ifFlyingKeepFlying>
  </JobDef>
