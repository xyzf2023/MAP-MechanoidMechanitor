<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <IncidentDef>
    <defName>MAP_SymbiosisCovenant_TradeDelegation</defName>
    <label>symbiosis covenant trade delegation</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MAP_MechanoidMechanitor.Scenarios.IncidentWorker_SymbiosisCovenantTradeDelegation</workerClass>
    <category>FactionArrival</category>
    <baseChance>0</baseChance>
    <requireColonistsPresent>true</requireColonistsPresent>
    <canOccurOnAllPlanetLayers>true</canOccurOnAllPlanetLayers>
  </IncidentDef>

  <MAP_MechanoidMechanitor.Scenarios.SymbiosisCovenantTradeDelegationDef>
    <defName>MAP_SymbiosisCovenant_TradeDelegationConfig</defName>
    <label>symbiosis covenant trade delegation configuration</label>

    <retryDelayTicks>60000</retryDelayTicks>
    <maxShortRetries>4</maxShortRetries>
    <carrierThingDivisor>8</carrierThingDivisor>
    <maxCarriers>8</maxCarriers>
    <repeatedLeadWeight>0.5</repeatedLeadWeight>
    <minimumIntervalDays>5</minimumIntervalDays>

    <levels>
      <li>
        <level>2</level>
        <intervalDays>12~15</intervalDays>
        <participantFactionCount>1~2</participantFactionCount>
        <memberPawnCount>5~8</memberPawnCount>
        <guardPointMultiplier>1.0</guardPointMultiplier>
        <silverMultiplier>2.0</silverMultiplier>
        <silverClamp>1500~3000</silverClamp>
        <logisticsSlots>2</logisticsSlots>
        <rareSlots>0</rareSlots>
        <minimumStock>
          <li><thingDef>ComponentIndustrial</thingDef><count>15</count></li>
          <li><thingDef>MedicineIndustrial</thingDef><count>10</count></li>
        </minimumStock>
        <contributionItemCount>0~0</contributionItemCount>
        <contributionMarketValue>0~0</contributionMarketValue>
      </li>
      <li>
        <level>3</level>
        <intervalDays>9~13</intervalDays>
        <participantFactionCount>2~3</participantFactionCount>
        <memberPawnCount>7~10</memberPawnCount>
        <guardPointMultiplier>1.15</guardPointMultiplier>
        <silverMultiplier>2.75</silverMultiplier>
        <silverClamp>2200~4000</silverClamp>
        <logisticsSlots>3</logisticsSlots>
        <rareSlots>1</rareSlots>
        <minimumStock>
          <li><thingDef>ComponentIndustrial</thingDef><count>20</count></li>
          <li><thingDef>MedicineIndustrial</thingDef><count>15</count></li>
        </minimumStock>
        <contributionItemCount>1</contributionItemCount>
        <contributionMarketValue>250~500</contributionMarketValue>
      </li>
      <li>
        <level>4</level>
        <intervalDays>7~10</intervalDays>
        <participantFactionCount>2~4</participantFactionCount>
        <memberPawnCount>9~13</memberPawnCount>
        <guardPointMultiplier>1.30</guardPointMultiplier>
        <silverMultiplier>3.5</silverMultiplier>
        <silverClamp>3000~5500</silverClamp>
        <logisticsSlots>4</logisticsSlots>
        <rareSlots>2</rareSlots>
        <minimumStock>
          <li><thingDef>ComponentIndustrial</thingDef><count>25</count></li>
          <li><thingDef>MedicineIndustrial</thingDef><count>20</count></li>
        </minimumStock>
        <contributionItemCount>1</contributionItemCount>
        <contributionMarketValue>400~750</contributionMarketValue>
      </li>
      <li>
        <level>5</level>
        <intervalDays>5~8</intervalDays>
        <participantFactionCount>3~5</participantFactionCount>
        <memberPawnCount>11~16</memberPawnCount>
        <guardPointMultiplier>1.50</guardPointMultiplier>
        <silverMultiplier>4.5</silverMultiplier>
        <silverClamp>4000~7000</silverClamp>
        <logisticsSlots>5</logisticsSlots>
        <rareSlots>3</rareSlots>
        <minimumStock>
          <li><thingDef>ComponentIndustrial</thingDef><count>30</count></li>
          <li><thingDef>MedicineIndustrial</thingDef><count>25</count></li>
        </minimumStock>
        <contributionItemCount>1~2</contributionItemCount>
        <contributionMarketValue>600~1000</contributionMarketValue>
      </li>
    </levels>

    <memberFrequencyTiers>
      <li><memberCount>1</memberCount><speedMultiplier>1.0</speedMultiplier></li>
      <li><memberCount>2~3</memberCount><speedMultiplier>1.08</speedMultiplier></li>
      <li><memberCount>4~6</memberCount><speedMultiplier>1.15</speedMultiplier></li>
      <li><memberCount>7~999</memberCount><speedMultiplier>1.20</speedMultiplier></li>
    </memberFrequencyTiers>

    <logisticsPool>
      <li>
        <minLevel>2</minLevel><maxLevel>5</maxLevel><weight>1.0</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Steel</thingDef><countRange>200~350</countRange></generator>
      </li>
      <li>
        <minLevel>2</minLevel><maxLevel>5</maxLevel><weight>0.8</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Cloth</thingDef><countRange>150~300</countRange></generator>
      </li>
      <li>
        <minLevel>2</minLevel><maxLevel>5</maxLevel><weight>1.0</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Chemfuel</thingDef><countRange>100~200</countRange></generator>
      </li>
      <li>
        <minLevel>2</minLevel><maxLevel>5</maxLevel><weight>1.0</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Neutroamine</thingDef><countRange>40~80</countRange></generator>
      </li>

      <li>
        <minLevel>3</minLevel><maxLevel>4</maxLevel><weight>1.0</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Plasteel</thingDef><countRange>40~80</countRange></generator>
      </li>
      <li>
        <minLevel>3</minLevel><maxLevel>3</maxLevel><weight>0.5</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>1~2</countRange></generator>
      </li>
      <li>
        <minLevel>3</minLevel><maxLevel>3</maxLevel><weight>0.6</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>ReinforcedBarrel</thingDef><countRange>1~2</countRange></generator>
      </li>

      <li>
        <minLevel>4</minLevel><maxLevel>4</maxLevel><weight>0.8</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Gold</thingDef><countRange>30~60</countRange></generator>
      </li>
      <li>
        <minLevel>4</minLevel><maxLevel>4</maxLevel><weight>0.8</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Uranium</thingDef><countRange>40~80</countRange></generator>
      </li>
      <li>
        <minLevel>4</minLevel><maxLevel>4</maxLevel><weight>0.5</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>MedicineUltratech</thingDef><countRange>1~3</countRange></generator>
      </li>
      <li>
        <minLevel>4</minLevel><maxLevel>4</maxLevel><weight>0.7</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>1~3</countRange></generator>
      </li>
      <li>
        <minLevel>4</minLevel><maxLevel>4</maxLevel><weight>0.7</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>ReinforcedBarrel</thingDef><countRange>1~3</countRange></generator>
      </li>

      <li>
        <minLevel>5</minLevel><maxLevel>5</maxLevel><weight>1.0</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Plasteel</thingDef><countRange>100~180</countRange></generator>
      </li>
      <li>
        <minLevel>5</minLevel><maxLevel>5</maxLevel><weight>0.8</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Gold</thingDef><countRange>50~90</countRange></generator>
      </li>
      <li>
        <minLevel>5</minLevel><maxLevel>5</maxLevel><weight>0.8</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Uranium</thingDef><countRange>60~120</countRange></generator>
      </li>
      <li>
        <minLevel>5</minLevel><maxLevel>5</maxLevel><weight>0.8</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>2~5</countRange></generator>
      </li>
      <li>
        <minLevel>5</minLevel><maxLevel>5</maxLevel><weight>0.6</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>MedicineUltratech</thingDef><countRange>2~5</countRange></generator>
      </li>
      <li>
        <minLevel>5</minLevel><maxLevel>5</maxLevel><weight>0.8</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>ReinforcedBarrel</thingDef><countRange>2~4</countRange></generator>
      </li>
    </logisticsPool>

    <rarePool>
      <li MayRequire="Ludeon.RimWorld.Royalty">
        <minLevel>3</minLevel><maxLevel>5</maxLevel><weight>1.0</weight>
        <generator Class="StockGenerator_Techprints">
          <countChances><li><count>1</count><chance>1</chance></li></countChances>
        </generator>
      </li>
      <li>
        <minLevel>3</minLevel><maxLevel>5</maxLevel><weight>0.8</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>TextBook</thingDef><countRange>1</countRange></generator>
      </li>
      <li>
        <minLevel>4</minLevel><maxLevel>5</maxLevel><weight>0.7</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Schematic</thingDef><countRange>1</countRange></generator>
      </li>
      <li>
        <minLevel>4</minLevel><maxLevel>5</maxLevel><weight>0.7</weight>
        <generator Class="StockGenerator_Tag"><tradeTag>Bionic</tradeTag><thingDefCountRange>1</thingDefCountRange><countRange>1</countRange><maxTechLevelGenerate>Spacer</maxTechLevelGenerate><maxTechLevelBuy>Spacer</maxTechLevelBuy></generator>
      </li>
      <li>
        <minLevel>4</minLevel><maxLevel>5</maxLevel><weight>0.6</weight>
        <generator Class="StockGenerator_Tag"><tradeTag>HiTechArmor</tradeTag><thingDefCountRange>1</thingDefCountRange><countRange>1</countRange><maxTechLevelGenerate>Spacer</maxTechLevelGenerate><maxTechLevelBuy>Spacer</maxTechLevelBuy></generator>
      </li>
      <li>
        <minLevel>4</minLevel><maxLevel>5</maxLevel><weight>0.6</weight>
        <generator Class="StockGenerator_MarketValue"><tradeTag>WeaponRanged</tradeTag><weaponTag>SpacerGun</weaponTag><countRange>1</countRange><maxTechLevelGenerate>Spacer</maxTechLevelGenerate><maxTechLevelBuy>Spacer</maxTechLevelBuy></generator>
      </li>
      <li MayRequire="Ludeon.RimWorld.Biotech">
        <minLevel>4</minLevel><maxLevel>5</maxLevel><weight>0.5</weight>
        <generator Class="StockGenerator_SingleDef"><thingDef>Genepack</thingDef><countRange>1</countRange></generator>
      </li>
    </rarePool>

    <excludedContributionDefNames>
      <!-- 后续可直接在此按 defName 添加不应进入参与派系贡献槽的物品。 -->
    </excludedContributionDefNames>
    <alwaysAllowedContributionDefNames>
      <!-- 后续可直接在此按 defName 强制允许贡献。黑名单优先于白名单。 -->
    </alwaysAllowedContributionDefNames>
  </MAP_MechanoidMechanitor.Scenarios.SymbiosisCovenantTradeDelegationDef>
</Defs>
