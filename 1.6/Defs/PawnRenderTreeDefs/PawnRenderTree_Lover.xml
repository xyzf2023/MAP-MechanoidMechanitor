<?xml version="1.0" encoding="utf-8"?> <!-- XML 声明 -->
<Defs> <!-- 定义根节点 -->

  <PawnRenderTreeDef> <!-- Pawn 渲染树定义 -->
    <defName>MAP_Lover</defName> <!-- 定义名称：Lover -->

    <root Class="PawnRenderNodeProperties_Parent"> <!-- 根节点（父节点类型） -->
      <debugLabel>Lover root</debugLabel> <!-- 调试标签：根节点 -->
      <tagDef>Root</tagDef> <!-- 渲染标签：根 -->

      <children> <!-- 子节点列表 -->

        <li> <!-- 身体节点 -->
          <debugLabel>Body</debugLabel> <!-- 调试标签：身体 -->
          <nodeClass>PawnRenderNode_Body</nodeClass> <!-- 节点类：身体 -->
          <workerClass>PawnRenderNodeWorker_Body</workerClass> <!-- 工作类：身体渲染 -->
          <tagDef>Body</tagDef> <!-- 渲染标签：身体 -->
          <skipFlag>Body</skipFlag> <!-- 跳过标志：身体 -->
          <pawnType>Any</pawnType> <!-- 适用 Pawn 类型：任意 -->

          <children> <!-- 身体子节点列表 -->

            <li Class="PawnRenderNodeProperties_Overlay"> <!-- 叠加层：服装前伤口 -->
              <debugLabel>Wounds - pre apparel</debugLabel> <!-- 调试标签：服装前伤口 -->
              <workerClass>PawnRenderNodeWorker_OverlayWounds</workerClass> <!-- 工作类：伤口叠加 -->
              <overlayLayer>Body</overlayLayer> <!-- 叠加层：身体 -->
              <baseLayer>8</baseLayer> <!-- 基础渲染层级：8 -->
            </li>

            <li Class="PawnRenderNodeProperties_Parent"> <!-- 父节点：身体服装根 -->
              <debugLabel>Apparel root</debugLabel> <!-- 调试标签：服装根 -->
              <tagDef>ApparelBody</tagDef> <!-- 渲染标签：身体服装 -->
              <baseLayer>20</baseLayer> <!-- 基础渲染层级：20 -->
            </li>

            <li Class="PawnRenderNodeProperties_Overlay"> <!-- 叠加层：服装后伤口 -->
              <debugLabel>Wounds - post apparel</debugLabel> <!-- 调试标签：服装后伤口 -->
              <workerClass>PawnRenderNodeWorker_OverlayWounds</workerClass> <!-- 工作类：伤口叠加 -->
              <overlayOverApparel>true</overlayOverApparel> <!-- 绘制在服装之上 -->
              <overlayLayer>Body</overlayLayer> <!-- 叠加层：身体 -->
              <baseLayer>30</baseLayer> <!-- 基础渲染层级：30 -->
            </li>

            <li Class="PawnRenderNodeProperties_Overlay"> <!-- 叠加层：灭火泡沫 -->
              <debugLabel>Firefoam</debugLabel> <!-- 调试标签：灭火泡沫 -->
              <workerClass>PawnRenderNodeWorker_OverlayFirefoam</workerClass> <!-- 工作类：灭火泡沫叠加 -->
              <overlayLayer>Body</overlayLayer> <!-- 叠加层：身体 -->
              <baseLayer>40</baseLayer> <!-- 基础渲染层级：40 -->
            </li>

          </children> <!-- 身体子节点列表结束 -->
        </li> <!-- 身体节点结束 -->

        <li> <!-- 头部残桩节点 -->
          <debugLabel>Head stump</debugLabel> <!-- 调试标签：头部残桩 -->
          <nodeClass>PawnRenderNode_Stump</nodeClass> <!-- 节点类：残桩 -->
          <workerClass>PawnRenderNodeWorker_Stump</workerClass> <!-- 工作类：残桩渲染 -->
          <texPath>Things/Pawn/Humanlike/Heads/None_Average_Stump</texPath> <!-- 贴图路径：通用残桩 -->
          <baseLayer>50</baseLayer> <!-- 基础渲染层级：50 -->
          <skipFlag>Head</skipFlag> <!-- 跳过标志：头部 -->
          <pawnType>Any</pawnType> <!-- 适用 Pawn 类型：任意 -->
          <rotDrawMode>Fresh, Rotting</rotDrawMode> <!-- 绘制模式：新鲜、腐烂 -->
        </li> <!-- 头部残桩节点结束 -->

        <li> <!-- 头部节点 -->
          <debugLabel>Head</debugLabel> <!-- 调试标签：头部 -->
          <nodeClass>PawnRenderNode_Head</nodeClass> <!-- 节点类：头部 -->
          <workerClass>PawnRenderNodeWorker_Head</workerClass> <!-- 工作类：头部渲染 -->
          <tagDef>Head</tagDef> <!-- 渲染标签：头部 -->
          <skipFlag>Head</skipFlag> <!-- 跳过标志：头部 -->
          <pawnType>Any</pawnType> <!-- 适用 Pawn 类型：任意 -->
          <baseLayer>50</baseLayer> <!-- 基础渲染层级：50 -->

          <children> <!-- 头部子节点列表 -->

            <li Class="PawnRenderNodeProperties_Parent"> <!-- 父节点：发型对齐根 -->
              <debugLabel>Hair alignment root</debugLabel> <!-- 调试标签：发型对齐根 -->
              <pawnType>Any</pawnType> <!-- 适用 Pawn 类型：任意 -->

              <drawData> <!-- 各朝向共享绘制数据 -->
                <dataNorth>
                  <offset>(0, 0, 0)</offset>
                </dataNorth>

                <dataEast>
                  <offset>(0, 0, 0)</offset>
                </dataEast>

                <dataSouth>
                  <offset>(0, 0, -0.25)</offset>
                </dataSouth>

                <dataWest>
                  <offset>(0, 0, 0)</offset>
                </dataWest>
              </drawData>

              <children> <!-- 发型子节点列表 -->

            <li> <!-- 后发节点 -->
              <debugLabel>Hair back</debugLabel> <!-- 调试标签：后发 -->
              <nodeClass>MAP_MechanoidMechanitor.PawnRenderNode_HairBack</nodeClass> <!-- 节点类：后发 -->
              <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass> <!-- 工作类：爬行时翻转 -->
              <pawnType>Any</pawnType> <!-- 适用 Pawn 类型：任意 -->
              <shaderTypeDef>CutoutHair</shaderTypeDef> <!-- 着色器：头发镂空 -->
              <colorType>Hair</colorType> <!-- 颜色类型：发色 -->
              <skipFlag>Hair</skipFlag> <!-- 跳过标志：头发 -->
              <baseLayer>49</baseLayer> <!-- 基础渲染层级：49 -->
              <rotDrawMode>Fresh, Rotting</rotDrawMode> <!-- 绘制模式：新鲜、腐烂 -->
            </li> <!-- 后发节点结束 -->

            <li> <!-- 前发节点 -->
              <debugLabel>Hair front</debugLabel> <!-- 调试标签：前发 -->
              <nodeClass>PawnRenderNode_Hair</nodeClass> <!-- 节点类：头发 -->
              <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass> <!-- 工作类：爬行时翻转 -->
              <pawnType>Any</pawnType> <!-- 适用 Pawn 类型：任意 -->
              <colorType>Hair</colorType> <!-- 颜色类型：发色 -->
              <skipFlag>Hair</skipFlag> <!-- 跳过标志：头发 -->
              <baseLayer>62</baseLayer> <!-- 基础渲染层级：62 -->
              <rotDrawMode>Fresh, Rotting</rotDrawMode> <!-- 绘制模式：新鲜、腐烂 -->
            </li> <!-- 前发节点结束 -->

              </children> <!-- 发型子节点列表结束 -->
            </li> <!-- 发型对齐根结束 -->

            <li Class="PawnRenderNodeProperties_Overlay"> <!-- 叠加层：头部伤口 -->
              <debugLabel>Head wounds</debugLabel> <!-- 调试标签：头部伤口 -->
              <workerClass>PawnRenderNodeWorker_OverlayWounds</workerClass> <!-- 工作类：伤口叠加 -->
              <overlayLayer>Head</overlayLayer> <!-- 叠加层：头部 -->
              <baseLayer>65</baseLayer> <!-- 基础渲染层级：65 -->
            </li>

            <li Class="PawnRenderNodeProperties_Parent"> <!-- 父节点：头部服装根 -->
              <debugLabel>Apparel root</debugLabel> <!-- 调试标签：服装根 -->
              <tagDef>ApparelHead</tagDef> <!-- 渲染标签：头部服装 -->
              <baseLayer>70</baseLayer> <!-- 基础渲染层级：70 -->
            </li>

            <li Class="PawnRenderNodeProperties_Overlay"> <!-- 叠加层：头部灭火泡沫 -->
              <debugLabel>Firefoam</debugLabel> <!-- 调试标签：灭火泡沫 -->
              <workerClass>PawnRenderNodeWorker_OverlayFirefoam</workerClass> <!-- 工作类：灭火泡沫叠加 -->
              <overlayLayer>Head</overlayLayer> <!-- 叠加层：头部 -->
              <baseLayer>85</baseLayer> <!-- 基础渲染层级：85 -->
            </li>

            <li Class="PawnRenderNodeProperties_Overlay"> <!-- 叠加层：状态效果 -->
              <debugLabel>Status overlay</debugLabel> <!-- 调试标签：状态叠加 -->
              <workerClass>PawnRenderNodeWorker_OverlayStatus</workerClass> <!-- 工作类：状态叠加 -->
              <baseLayer>100</baseLayer> <!-- 基础渲染层级：100 -->
            </li>

          </children> <!-- 头部子节点列表结束 -->
        </li> <!-- 头部节点结束 -->

        <li Class="PawnRenderNodeProperties_Carried"> <!-- 携带物节点 -->
          <debugLabel>Weapon/carried thing</debugLabel> <!-- 调试标签：武器/携带物 -->
          <workerClass>PawnRenderNodeWorker_Carried</workerClass> <!-- 工作类：携带物渲染 -->
        </li> <!-- 携带物节点结束 -->

      </children> <!-- 根子节点列表结束 -->
    </root> <!-- 根节点结束 -->
  </PawnRenderTreeDef> <!-- Pawn 渲染树定义结束 -->

</Defs> <!-- 定义根节点结束 -->
