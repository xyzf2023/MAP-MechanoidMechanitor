<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 仅动画，不使用 Projectile 类和 Projectile 类别，不注册原版飞行物拦截路径。 -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>MAP_AnnihilationShot</defName>
    <label>湮灭炮弹</label>
    <thingClass>MAP_MechanoidMechanitor.AnnihilationShot</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <drawOffscreen>true</drawOffscreen>
    <graphicData>
      <texPath>Things/Projectile/HellsphereCannon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(1.5, 3)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="EtherealThingBase">
    <defName>MAP_AnnihilationImpact</defName>
    <label>湮灭场</label>
    <thingClass>MAP_MechanoidMechanitor.AnnihilationImpact</thingClass>
    <comps>
      <li Class="MAP_MechanoidMechanitor.CompProperties_AnnihilationSky" />
    </comps>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <drawOffscreen>true</drawOffscreen>
  </ThingDef>

  <ThingDef ParentName="EtherealThingBase">
    <defName>MAP_AnnihilationExplosion</defName>
    <label>湮灭炮冲击</label>
    <thingClass>MAP_MechanoidMechanitor.AnnihilationExplosion</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <drawerType>None</drawerType>
    <useHitPoints>false</useHitPoints>
  </ThingDef>
</Defs>
