<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MAP_DuplicateRegularSubcore</defName>
    <label>复制次生核心（标准）</label>
    <description>通过对机械族数据处理的深入研究，我们掌握了使用已有数据直接复制次生核心（标准）的方法。</description>
    <jobString>正在复制次生核心（标准）。</jobString>
    <researchPrerequisite>MAP_ConsciousnessStructureCopy</researchPrerequisite>
    <workAmount>12500</workAmount>
    <workSpeedStat>SubcoreEncodingSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>12</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>SubcoreEncoder</li>
    </recipeUsers>
    <mechanitorOnlyRecipe>true</mechanitorOnlyRecipe>
    <unfinishedThingDef>UnfinishedSubcore</unfinishedThingDef>
    <soundWorking>SubcoreEncoder_Working</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>SubcoreRegular</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SubcoreRegular</li>
        <li>Steel</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <SubcoreRegular>2</SubcoreRegular>
    </products>
  </RecipeDef>

