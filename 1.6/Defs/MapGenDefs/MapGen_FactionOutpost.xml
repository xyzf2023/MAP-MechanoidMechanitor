<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 地点只区分建设阶段。建筑群尺寸读取前哨创建时固定的档位，
       sizesByTier 顺序：Baseline、Expanded、Large、Fortress；0 表示不生成。
       各步骤复用原版 GenStep_Outpost，全部建筑生成后统一供电，守军由 PostMapGenerate 生成。 -->
  <GenStepDef>
    <defName>MAP_FactionOutpost_Building_Outpost</defName>
    <linkWithSite>MAP_FactionOutpost_Building</linkWithSite>
    <order>400</order>
    <genStep Class="MAP_MechanoidMechanitor.Scenarios.GenStep_FactionOutpost">
      <sizesByTier>
        <li>20</li>
        <li>22</li>
        <li>24</li>
        <li>26</li>
      </sizesByTier>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>MAP_FactionOutpost_Building_Power</defName>
    <linkWithSite>MAP_FactionOutpost_Building</linkWithSite>
    <order>410</order>
    <genStep Class="GenStep_Power" />
  </GenStepDef>

  <GenStepDef>
    <defName>MAP_FactionOutpost_Completed_MainOutpost</defName>
    <linkWithSite>MAP_FactionOutpost_Completed</linkWithSite>
    <order>400</order>
    <genStep Class="MAP_MechanoidMechanitor.Scenarios.GenStep_FactionOutpost">
      <sizesByTier>
        <li>24</li>
        <li>26</li>
        <li>30</li>
        <li>34</li>
      </sizesByTier>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>MAP_FactionOutpost_Completed_SecondaryOutpost</defName>
    <linkWithSite>MAP_FactionOutpost_Completed</linkWithSite>
    <order>401</order>
    <genStep Class="MAP_MechanoidMechanitor.Scenarios.GenStep_FactionOutpost">
      <sizesByTier>
        <li>16</li>
        <li>18</li>
        <li>20</li>
        <li>24</li>
      </sizesByTier>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>MAP_FactionOutpost_Completed_ThirdOutpost</defName>
    <linkWithSite>MAP_FactionOutpost_Completed</linkWithSite>
    <order>402</order>
    <genStep Class="MAP_MechanoidMechanitor.Scenarios.GenStep_FactionOutpost">
      <sizesByTier>
        <li>0</li>
        <li>0</li>
        <li>16</li>
        <li>18</li>
      </sizesByTier>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>MAP_FactionOutpost_Completed_Power</defName>
    <linkWithSite>MAP_FactionOutpost_Completed</linkWithSite>
    <order>410</order>
    <genStep Class="GenStep_Power" />
  </GenStepDef>
</Defs>
