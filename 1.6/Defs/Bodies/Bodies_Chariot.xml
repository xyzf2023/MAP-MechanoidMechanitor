<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <BodyDef>
    <defName>MAP_Body_Chariot</defName>
    <label>「战车」身体</label>
    <!-- 外壳采用人形布局，功能部位复用原版机械定义；手脚不细分指趾。 -->
    <corePart>
      <def>MechanicalThorax</def>
      <customLabel>躯干</customLabel>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>MechanicalNeck</def>
          <customLabel>机械颈</customLabel>
          <coverage>0.075</coverage>
          <height>Top</height>
          <groups>
            <li>Neck</li>
          </groups>
          <parts>
            <li>
              <def>MechanicalHead</def>
              <customLabel>头部</customLabel>
              <coverage>0.80</coverage>
              <groups>
                <li>UpperHead</li>
                <li>FullHead</li>
                <li>HeadAttackTool</li>
              </groups>
              <parts>
                <li>
                  <def>ArtificialBrain</def>
                  <customLabel>控制核心</customLabel>
                  <coverage>0.1</coverage>
                  <depth>Inside</depth>
                  <groups>
                    <li>UpperHead</li>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>SightSensor</def>
                  <customLabel>左视觉传感器</customLabel>
                  <coverage>0.13</coverage>
                  <groups>
                    <li>FullHead</li>
                    <li>Eyes</li>
                  </groups>
                </li>
                <li>
                  <def>SightSensor</def>
                  <customLabel>右视觉传感器</customLabel>
                  <coverage>0.13</coverage>
                  <groups>
                    <li>FullHead</li>
                    <li>Eyes</li>
                  </groups>
                </li>
                <li>
                  <def>HearingSensor</def>
                  <customLabel>左听觉传感器</customLabel>
                  <coverage>0.1</coverage>
                  <groups>
                    <li>UpperHead</li>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>HearingSensor</def>
                  <customLabel>右听觉传感器</customLabel>
                  <coverage>0.1</coverage>
                  <groups>
                    <li>UpperHead</li>
                    <li>FullHead</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>MechanicalShoulder</def>
          <customLabel>左肩</customLabel>
          <coverage>0.12</coverage>
          <groups>
            <li>Shoulders</li>
          </groups>
          <parts>
            <li>
              <def>MechanicalArm</def>
              <customLabel>左臂</customLabel>
              <coverage>0.77</coverage>
              <groups>
                <li>Arms</li>
              </groups>
              <parts>
                <li>
                  <def>MechanicalHand</def>
                  <customLabel>左手</customLabel>
                  <coverage>0.14</coverage>
                  <height>Bottom</height>
                  <groups>
                    <li>Hands</li>
                    <li>LeftHand</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>MechanicalShoulder</def>
          <customLabel>右肩</customLabel>
          <coverage>0.12</coverage>
          <groups>
            <li>Shoulders</li>
          </groups>
          <parts>
            <li>
              <def>MechanicalArm</def>
              <customLabel>右臂</customLabel>
              <coverage>0.77</coverage>
              <groups>
                <li>Arms</li>
              </groups>
              <parts>
                <li>
                  <def>MechanicalHand</def>
                  <customLabel>右手</customLabel>
                  <coverage>0.14</coverage>
                  <height>Bottom</height>
                  <groups>
                    <li>Hands</li>
                    <li>RightHand</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>MechanicalLeg</def>
          <customLabel>左腿</customLabel>
          <coverage>0.14</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
          <parts>
            <li>
              <def>MechanicalFoot</def>
              <customLabel>左脚</customLabel>
              <coverage>0.1</coverage>
              <groups>
                <li>Feet</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>MechanicalLeg</def>
          <customLabel>右腿</customLabel>
          <coverage>0.14</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
          <parts>
            <li>
              <def>MechanicalFoot</def>
              <customLabel>右脚</customLabel>
              <coverage>0.1</coverage>
              <groups>
                <li>Feet</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>Reactor</def>
          <customLabel>反应堆</customLabel>
          <coverage>0.06</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>FluidReprocessor</def>
          <customLabel>体液处理器</customLabel>
          <coverage>0.04</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
      </parts>
    </corePart>
  </BodyDef>
</Defs>
