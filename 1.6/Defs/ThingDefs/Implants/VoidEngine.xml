<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MechanitorImplantCraftableBase" MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_VoidEngine</defName>
    <label>虚空引擎</label>
    <description>一种能够稳定微型虚空泡，并从量子真空中持续汲取能量的机械师植入体。它会通过监管链路为受监管机械族的反应堆供能，使其停止日常能量消耗、避免因机体受损而损失能量，并缓慢恢复能量储备。</description>
    <costList>
      <MAP_QuantumComputingChip>1</MAP_QuantumComputingChip>
      <ComponentSpacer>6</ComponentSpacer>
      <Uranium>75</Uranium>
      <Gold>5</Gold>
    </costList>
    <statBases>
      <MaxInstallCount>1</MaxInstallCount>
      <MarketValue>1500</MarketValue>
      <WorkToMake>18000</WorkToMake>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>MAP_QuantumVacuumExtraction</researchPrerequisite>
      <skillRequirements Inherit="False">
        <Crafting>12</Crafting>
      </skillRequirements>
    </recipeMaker>
    <comps>
      <li Class="CompProperties_Usable">
        <compClass>CompUsableImplant</compClass>
        <useJob>UseItem</useJob>
        <useLabel>植入虚空引擎</useLabel>
        <userMustHaveHediff>MechlinkImplant</userMustHaveHediff>
      </li>
      <li Class="CompProperties_UseEffectInstallImplant">
        <hediffDef>MAP_VoidEngine</hediffDef>
        <bodyPart>Brain</bodyPart>
        <canUpgrade>false</canUpgrade>
        <requiresExistingHediff>false</requiresExistingHediff>
        <maxSeverity>1</maxSeverity>
      </li>
    </comps>
  </ThingDef>
</Defs>
