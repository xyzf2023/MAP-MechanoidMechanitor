<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MechanitorImplantCraftableBase" MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_RepairBeacon</defName>
    <label>修复信标</label>
    <description>一种内置量子结构演算阵列的机械师植入体。它能持续解析受监管机械族的结构损伤，并通过监管链路下发精确的自我修复序列；必要时还可超负荷运行，启动战地修复协议来引导机械族快速自我修复。</description>
    <costList>
      <MAP_QuantumComputingChip>1</MAP_QuantumComputingChip>
      <Plasteel>20</Plasteel>
      <Gold>30</Gold>
      <Uranium>5</Uranium>
      <ComponentSpacer>10</ComponentSpacer>
    </costList>
    <statBases>
      <MaxInstallCount>1</MaxInstallCount>
      <MarketValue>3000</MarketValue>
      <WorkToMake>24000</WorkToMake>
    </statBases>
    <thingCategories Inherit="False">
      <li>MAP_MechanoidMechanitorBodyParts</li>
    </thingCategories>
    <recipeMaker>
      <researchPrerequisite>MAP_QuantumStructuralRestoration</researchPrerequisite>
      <skillRequirements Inherit="False">
        <Crafting>12</Crafting>
      </skillRequirements>
    </recipeMaker>
    <comps>
      <li Class="CompProperties_Usable">
        <compClass>CompUsableImplant</compClass>
        <useJob>UseItem</useJob>
        <useLabel>植入修复信标</useLabel>
        <userMustHaveHediff>MechlinkImplant</userMustHaveHediff>
      </li>
      <li Class="CompProperties_UseEffectInstallImplant">
        <hediffDef>MAP_RepairBeacon</hediffDef>
        <bodyPart>Brain</bodyPart>
        <canUpgrade>false</canUpgrade>
        <requiresExistingHediff>false</requiresExistingHediff>
        <maxSeverity>1</maxSeverity>
      </li>
    </comps>
  </ThingDef>
</Defs>
