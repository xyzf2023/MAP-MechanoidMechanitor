<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="MAP_SunBase">
    <defName>MAP_Mech_SunBOSS</defName>
    <label>「太阳」- 能源核心</label>
    <description>TODO</description>
    <race>
      <baseHealthScale>8</baseHealthScale>
      <thinkTreeMain>MAP_SunBossCombat</thinkTreeMain>
      <thinkTreeConstant>MAP_SunBossConstant</thinkTreeConstant>
    </race>
    <statBases>
      <MoveSpeed>1.0</MoveSpeed>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">9999</BandwidthCost>
    </statBases>
    <killedLeavings Inherit="False">
      <MAP_AntimatterContainmentDevice>1</MAP_AntimatterContainmentDevice>
    </killedLeavings>
    <killedLeavingsChance>1</killedLeavingsChance>
    <comps>

      <li Class="MAP_MechanoidMechanitor.CompProperties_SunBossState">
        <maxStructure>8000</maxStructure>
        <coolingFailureDamagePerSecond>6</coolingFailureDamagePerSecond>
        <unstableDamagePerSecond>48</unstableDamagePerSecond>
        <criticalDamagePerSecond>240</criticalDamagePerSecond>
      </li>
      <!-- 太阳BOSS热场 -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_SunBossHeatAura" />
      <!-- 能量脉冲数值 -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_EnergyPulse">
        <warmupTicks>180</warmupTicks>
        <radius>10</radius>
        <stunTicks>300</stunTicks>
        <propagationSpeed>0.5</propagationSpeed>
        <cooldownTicks>0</cooldownTicks>
        <releaseEffecter>BlastMechBandShockwave</releaseEffecter>
        <effectReferenceRadius>30.9</effectReferenceRadius>
        <iconPath>UI/Commands/MM_EnergyPulse</iconPath>
      </li>
      <!-- 湮灭炮 -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_AnnihilationCannon">
        <warmupTicks>600</warmupTicks>
        <innerRadius>4.9</innerRadius>
        <outerRadius>9.8</outerRadius>
        <skipEffectRadius>15</skipEffectRadius>
        <explosionDamage>1000</explosionDamage>
        <armorPenetration>15</armorPenetration>
        <range>37.8</range>
        <minRange>5.9</minRange>
        <projectileSpeed>75</projectileSpeed>
        <phaseDelayTicks>3</phaseDelayTicks>
        <cooldownTicks>0</cooldownTicks>
        <effectExpandTicks>15</effectExpandTicks>
        <effectHoldTicks>60</effectHoldTicks>
        <effectContractTicks>20</effectContractTicks>
      </li>
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="MAP_SunKindBase">
    <defName>MAP_Mech_SunBOSS</defName>
    <label>「太阳」</label>
    <race>MAP_Mech_SunBOSS</race>
    <defaultFactionDef>Mechanoid</defaultFactionDef>
    <destroyGearOnDrop>true</destroyGearOnDrop>
    <isBoss>true</isBoss>
  </PawnKindDef>

</Defs>
