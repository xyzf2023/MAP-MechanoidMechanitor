<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseMechanoid">
    <defName>MAP_Mech_Chariot</defName>
    <label>「战车」</label>
    <description>为与人类协同作战而设计的外骨骼机械体。「战车」能将自身结构展开为包覆穿戴者的机械外骨骼，在提供坚固防护的同时，将机体的动力与作战系统直接交由穿戴者使用。\n\n「战车」搭载了先进的无工质推进系统与高能激光武器。其机体针对飞行进行了专门调整，能够长时间滞空，并以高能光束持续压制目标。此外，机体还可转换为驻定形态，以适应不同的作战与部署需求。\n\n选中战车，右键其监管者以下达合体命令。\n\n升格为机械族机械师的战车可以与任意人类合体。部分量子机械科技插件在合体状态下还能够与穿戴者产生额外的协同效果。</description>

    <statBases>
      <MarketValue>1500</MarketValue>
      <MoveSpeed>4.2</MoveSpeed>
      <ArmorRating_Blunt>1.20</ArmorRating_Blunt>
      <ArmorRating_Sharp>1.20</ArmorRating_Sharp>
      <ArmorRating_Heat>2.0</ArmorRating_Heat>
      <CarryingCapacity>500</CarryingCapacity>
      <BandwidthCost>3</BandwidthCost>
      <MechEnergyLossPerHP>0.40</MechEnergyLossPerHP>
      <ControlTakingTime>18</ControlTakingTime>
    </statBases>

    <tools Inherit="False">
      <li>
        <label>左机械拳</label>
        <labelNoLocation>机械拳</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <armorPenetration>0.18</armorPenetration>
        <cooldownTime>1.2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>

      <li>
        <label>右机械拳</label>
        <labelNoLocation>机械拳</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <armorPenetration>0.18</armorPenetration>
        <cooldownTime>1.2</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>

      <li>
        <label>头撞</label>
        <labelNoLocation>头撞</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <armorPenetration>0.08</armorPenetration>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>

    <butcherProducts>
      <Steel>30</Steel>
      <Plasteel>10</Plasteel>
    </butcherProducts>

    <race>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>Mechanoid</thinkTreeMain>
      <baseBodySize>2</baseBodySize>
      <body>MAP_Body_Chariot</body>
      <baseHealthScale>3</baseHealthScale>
      <soundMeleeHitPawn>Pawn_Melee_MechanoidBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidBash_Miss</soundMeleeMiss>
      <mechWeightClass>Heavy</mechWeightClass>

      <lifeStageAges Inherit="False">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
        <li MayRequire="Ludeon.RimWorld.Biotech">
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>

    <comps>
      <!-- 战车专用建筑转换：组件同时提供资格、目标建筑与转换按钮。 -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_ChariotBuildingConversion">
        <buildingFormDef>MAP_Building_Chariot</buildingFormDef>
        <placementSearchRadius>8</placementSearchRadius>
      </li>

      <!-- 两种激光共用源战车上的组件与冷却；合体形态也读取此组件。 -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_ChariotLaserSystem">
        <range>29.9</range>
        <minRange>2.9</minRange>
        <sweepMaxSpan>10</sweepMaxSpan>
        <effectRadius>1.5</effectRadius>
        <warmupTicks>60</warmupTicks>
        <trackingDurationTicks>600</trackingDurationTicks>
        <sweepDurationTicks>240</sweepDurationTicks>
        <energyIntervalTicks>6</energyIntervalTicks>
        <pawnDamageIntervalTicks>10</pawnDamageIntervalTicks>
        <energyFractionPerInterval>0.0005</energyFractionPerInterval>
        <trackingPrimaryDamage>9</trackingPrimaryDamage>
        <trackingSplashDamage>4.5</trackingSplashDamage>
        <sweepCenterDamage>12</sweepCenterDamage>
        <sweepSplashDamage>6</sweepSplashDamage>
        <buildingDamage>50</buildingDamage>
        <armorPenetration>1.5</armorPenetration>
        <trackingIgnitionChance>0.7</trackingIgnitionChance>
        <splashIgnitionChance>0.3</splashIgnitionChance>
        <sweepIgnitionChance>0.4</sweepIgnitionChance>
        <muzzleFlashIntervalTicks>22</muzzleFlashIntervalTicks>
        <muzzleFlashScale>9</muzzleFlashScale>
        <heatDamageDef>MAP_ChariotLaserHeat</heatDamageDef>
        <buildingDamageDef>MAP_ChariotLaserSiege</buildingDamageDef>
        <beamMoteDef>Mote_MAP_ChariotLaserBeam</beamMoteDef>
        <beamSoundDef>BeamGraser_Shooting</beamSoundDef>
      </li>

      <!-- 战车天生拥有飞行资格 -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_MechanicalFlightInnate">
        <profile>MAP_DefaultMechanicalFlightProfile</profile>
        <energyDrainMultiplier>0.25</energyDrainMultiplier>
      </li>

      <!-- 战车天生拥有合体资格 -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_MechFusionInnate" />
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="BaseMechanoidKind">
    <defName>MAP_Mech_Chariot</defName>
    <label>「战车」</label>
    <race>MAP_Mech_Chariot</race>
    <defaultFactionDef>PlayerColony</defaultFactionDef>
    <controlGroupPortraitZoom>1.0</controlGroupPortraitZoom>

    <combatPower>225</combatPower>

    <allowInMechClusters>false</allowInMechClusters>
    <appearsRandomlyInCombatGroups>false</appearsRandomlyInCombatGroups>

    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Chariot/Chariot</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.35</drawSize>
          <shadowData>
            <volume>(0.35,0.45,0.35)</volume>
            <offset>(0,0,-0.2)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Chariot/Chariot</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.35</drawSize>
          <shadowData>
            <volume>(0.35,0.45,0.35)</volume>
            <offset>(0,0,-0.2)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>

  </PawnKindDef>
</Defs>
