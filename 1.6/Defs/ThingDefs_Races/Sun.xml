<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="MAP_SunBase">
    <defName>MAP_Mech_Sun</defName>
    <label>「太阳」</label>
    <description>通过对反物质约束器进行研究后重构出的机械体。「太阳」并非传统意义上的机械族，它更像是一座能够自行移动的高能反应堆。当其固定自身位置并转换为建筑形态时，体内的反物质反应堆能够持续为殖民地提供近乎无限的能源。\n\n即便并非专为战斗设计，「太阳」依旧拥有极其恐怖的作战能力。其搭载的高能激光能够持续灼烧目标，而湮灭炮则足以对大片区域造成毁灭性打击。\n\n这台「太阳」经过了针对殖民地使用环境的重新改装，不再依赖外部稳定器维持运行，同时也更适合长期部署与日常使用。「太阳」在场时，其特制的能源输出装置还会为所有殖民地机械体提供「日冕」效果，大幅降低机械体的能量消耗。\n\n注意：「太阳」运行时会持续产生大量热量，不要将其长时间部署在室内。</description>
    <race>
      <baseHealthScale>3</baseHealthScale>
    </race>
    <statBases>
      <MarketValue>20000</MarketValue>
      <MoveSpeed>3.0</MoveSpeed>
      <BandwidthCost>20</BandwidthCost>
    </statBases>
    <comps>
      <!-- 玩家太阳：湮灭炮数值 -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_AnnihilationCannon">
        <warmupTicks>300</warmupTicks>
        <deployTicks>60</deployTicks>
        <brakeTicks>36</brakeTicks>
        <alignTicks>30</alignTicks>
        <closeTicks>24</closeTicks>
        <innerRadius>4.9</innerRadius>
        <outerRadius>9.8</outerRadius>
        <skipEffectRadius>15</skipEffectRadius>
        <explosionDamage>1000</explosionDamage>
        <armorPenetration>15</armorPenetration>
        <range>37.8</range>
        <minRange>5.9</minRange>
        <projectileSpeed>75</projectileSpeed>
        <phaseDelayTicks>3</phaseDelayTicks>
        <cooldownTicks>2500</cooldownTicks>
        <effectExpandTicks>15</effectExpandTicks>
        <effectHoldTicks>60</effectHoldTicks>
        <effectContractTicks>20</effectContractTicks>
      </li>
      <!-- 玩家太阳：高能激光束蓄力时跟随 Pawn -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_HighEnergyLaserBeam">
        <range>35</range>
        <warmupTicks>60</warmupTicks>
        <cooldownTicks>60</cooldownTicks>
        <damageAmount>50</damageAmount>
        <durationTicks>300</durationTicks>
        <recoveryTicks>36</recoveryTicks>
        <trackingSpeed>2.5</trackingSpeed>
        <trackPawnDuringWarmup>true</trackPawnDuringWarmup>
        <allowAutoFire>true</allowAutoFire>
      </li>
      <!-- 产热组件 -->
      <li Class="CompProperties_HeatPusher">
        <compClass>MAP_MechanoidMechanitor.CompPawnHeatPusher</compClass>
        <heatPerSecond>100</heatPerSecond>
        <heatPushMaxTemperature>50</heatPushMaxTemperature>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_SunEnergyAura" />
      <li Class="MAP_MechanoidMechanitor.CompProperties_AutonomousMech">
        <setting>Sun</setting>
      </li>
      <!-- 玩家太阳：能量脉冲数值 -->
      <li Class="MAP_MechanoidMechanitor.CompProperties_EnergyPulse">
        <warmupTicks>180</warmupTicks>
        <recoveryTicks>42</recoveryTicks>
        <radius>10</radius>
        <stunTicks>300</stunTicks>
        <propagationSpeed>2.5</propagationSpeed>
        <cooldownTicks>300</cooldownTicks>
        <releaseEffecter>BlastMechBandShockwave</releaseEffecter>
        <effectReferenceRadius>30.9</effectReferenceRadius>
        <iconPath>UI/Commands/MM_EnergyPulse</iconPath>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_MechBuildingConversion">
        <buildingFormDef>MAP_Building_Sun</buildingFormDef>
        <iconPath>UI/Commands/MM_SunBuildingConversion</iconPath>
      </li>
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="MAP_SunKindBase">
    <defName>MAP_Mech_Sun</defName>
    <label>「太阳」</label>
    <race>MAP_Mech_Sun</race>
    <isBoss>true</isBoss>
    <defaultFactionDef>PlayerColony</defaultFactionDef>
  </PawnKindDef>

</Defs>
