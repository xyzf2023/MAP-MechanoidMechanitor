<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="BaseMechanoid">
    <defName>MAP_Mech_Hermit</defName>
    <label>「隐者」</label>
    <description>「隐者」是一种装备了大功率信号中继装置的机械体，搭载了带宽信息处理模块，拥有独立带宽。该机械体可以精确接收机械师的指挥信号，进而脱离机械师范围行动，并能独立带领远征队。\n\n注意：「隐者」控制的机械体只能在其控制范围内被征召。</description>
    <statBases>
      <MarketValue>1000</MarketValue>
      <MoveSpeed>2.0</MoveSpeed>
      <WorkSpeedGlobal>1</WorkSpeedGlobal>
      <EnergyShieldRechargeRate>0.25</EnergyShieldRechargeRate>
      <EnergyShieldEnergyMax>1.5</EnergyShieldEnergyMax>
      <MechEnergyLossPerHP>0.25</MechEnergyLossPerHP>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">5</BandwidthCost>
      <ControlTakingTime>15</ControlTakingTime>
      <EMPResistance>0</EMPResistance>
      <ArmorRating_Blunt>0.60</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.80</ArmorRating_Sharp>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <armorPenetration>0.16</armorPenetration>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="MAP_MechanoidMechanitor.CompProperties_MAPMechanitorNode">
        <controlBackend>Vanilla</controlBackend>
        <requiresExternalOverseer>true</requiresExternalOverseer>
        <ignoreExternalOverseerCommandRange>true</ignoreExternalOverseerCommandRange>
        <extraMechBandwidth>8</extraMechBandwidth>
        <extraMechControlGroups>1</extraMechControlGroups>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_CommanderSkills">
        <bodyType>Male</bodyType>
        <skillLevels>
          <li>
            <skill>Intellectual</skill>
            <level>12</level>
          </li>
          <li>
            <skill>Shooting</skill>
            <level>10</level>
          </li>
          <li>
            <skill>Melee</skill>
            <level>8</level>
          </li>

        </skillLevels>
      </li>

      <li Class="MAP_MechanoidMechanitor.CompProperties_HumanWeaponUser">
        <allowEquipFloatMenu>true</allowEquipFloatMenu>
        <allowDropEquipmentFloatMenu>true</allowDropEquipmentFloatMenu>
        <ensureEquipmentTracker>true</ensureEquipmentTracker>
      </li>

      <li Class="MAP_MechanoidMechanitor.CompProperties_MechRestrictedWorkGiverUser">
        <allowedWorkTypes>
          <li>Research</li>
        </allowedWorkTypes>
      </li>
      
      <li Class="MAP_MechanoidMechanitor.CompProperties_MAPMechanitorTravelNode">
        <canLeadCaravan>true</canLeadCaravan>
        <canCollectCaravanItems>true</canCollectCaravanItems>
        <refreshTrackersOnTransporterArrival>true</refreshTrackersOnTransporterArrival>
      </li>
    </comps>
    <race>
      <body>MAP_Body_Hermit</body>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>Mechanoid</thinkTreeMain>
      <baseBodySize>1.0</baseBodySize>
      <baseHealthScale>1.32</baseHealthScale>
      <mechWeightClass>Medium</mechWeightClass>
      <lifeStageAges Inherit="False">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
        <li MayRequire="Ludeon.RimWorld.Biotech">
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_MechanoidBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidBash_Miss</soundMeleeMiss>
      <mechFixedSkillLevel>10</mechFixedSkillLevel>
      <mechEnabledWorkTypes>
        <li>Research</li>
      </mechEnabledWorkTypes>
    </race>
    <butcherProducts Inherit="False">
      <Steel>15</Steel>
    </butcherProducts>
  </ThingDef>

  <PawnKindDef ParentName="BaseMechanoidKind">
    <defName>MAP_Mech_Hermit</defName>
    <label>「隐者」</label>
    <race>MAP_Mech_Hermit</race>
    <defaultFactionDef>PlayerColony</defaultFactionDef>
    <destroyGearOnDrop>false</destroyGearOnDrop>
    <combatPower>150</combatPower>
    <allowInMechClusters>false</allowInMechClusters>
    <appearsRandomlyInCombatGroups>false</appearsRandomlyInCombatGroups>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Hermit/Hermit</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2</drawSize>
          <shadowData>
            <volume>(0.4, 0.8, 0.4)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Hermit/Hermit</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2</drawSize>
          <shadowData>
            <volume>(0.4, 0.8, 0.4)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
