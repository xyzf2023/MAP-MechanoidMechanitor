<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="MAP_JusticeBase">
    <defName>MAP_Mech_Justice</defName>
    <label>「正义」</label>
    <description>为开辟新机械巢节点而设计的重装指挥机械体。「正义」最初是机械巢制造的完全自律单元，具备强大的自主决策能力。它无需监管者便能维持机控网络，指挥下属机械体投入生产与作战。据说，只需部署一台「正义」和少量辅助机械族，就足以在荒野中从零建立起一座完整的机械巢节点。\n\n「正义」拥有足以独立判断和行动的智能，几乎可以视作一名机械体殖民者，在某些领域甚至远胜于人类。为应对拓荒途中多变的环境，它配备了厚重的装甲，即使赤手空拳也拥有可观的战斗力。除了统率下属，它自身也擅长各类生产工作，能够亲手完成建立新节点所需的工作。</description>
    <statBases>
      <MarketValue>6000</MarketValue>
      <WorkSpeedGlobal>1</WorkSpeedGlobal>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">0</BandwidthCost>
      <PilotingAbility MayRequire="Ludeon.RimWorld.Odyssey">2</PilotingAbility>
      <ControlTakingTime>10</ControlTakingTime>
      <WastepacksPerRecharge MayRequire="Ludeon.RimWorld.Biotech">0</WastepacksPerRecharge>
    </statBases>
    <comps>
      <li Class="MAP_MechanoidMechanitor.CompProperties_WardenWorkUser">
        <defaultPriority>3</defaultPriority>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_AnimalHandlingWorkUser">
        <defaultPriority>3</defaultPriority>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_MechanicalChildcareUser">
        <defaultPriority>3</defaultPriority>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_NativeMechanoidMechanitor" />
      <li Class="MAP_MechanoidMechanitor.CompProperties_MAPMechanitorNode">
        <controlBackend>Vanilla</controlBackend>
        <extraMechBandwidth>20</extraMechBandwidth>
        <extraMechControlGroups>5</extraMechControlGroups>
        <allowBossChipBandwidthUpgrade>true</allowBossChipBandwidthUpgrade>
        <maxIntrinsicBandwidth>500</maxIntrinsicBandwidth>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_CommanderSkills">
        <bodyType>Male</bodyType>
        <childhoodBackstory>MAP_Justice_Childhood</childhoodBackstory>
        <adulthoodBackstory>MAP_Justice_Adulthood</adulthoodBackstory>
        <skillLevels>
          <li>
            <skill>Shooting</skill> <!-- 射击 -->
            <level>18</level>
          </li>
          <li>
            <skill>Melee</skill> <!-- 格斗 -->
            <level>16</level>
          </li>
          <li>
            <skill>Social</skill> <!-- 社交 -->
            <level>12</level>
          </li>
          <li>
            <skill>Crafting</skill> <!-- 制作 -->
            <level>16</level>
          </li>
          <li>
            <skill>Construction</skill> <!-- 建造 -->
            <level>10</level>
          </li>
          <li>
            <skill>Mining</skill> <!-- 采矿 -->
            <level>6</level>
          </li>
          <li>
            <skill>Cooking</skill> <!-- 烹饪 -->
            <level>6</level>
          </li>
          <li>
            <skill>Plants</skill> <!-- 种植 -->
            <level>6</level>
          </li>
          <li>
            <skill>Animals</skill> <!-- 驯兽 -->
            <level>6</level>
          </li>
          <li>
            <skill>Artistic</skill> <!-- 艺术 -->
            <level>10</level>
          </li>
          <li>
            <skill>Medicine</skill> <!-- 医疗 -->
            <level>6</level>
          </li>
          <li>
            <skill>Intellectual</skill> <!-- 智识 -->
            <level>12</level>
          </li>
        </skillLevels>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_HumanWeaponUser">
        <allowEquipFloatMenu>true</allowEquipFloatMenu>
        <allowDropEquipmentFloatMenu>true</allowDropEquipmentFloatMenu>
        <ensureEquipmentTracker>true</ensureEquipmentTracker>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_ColonistLikeFloatMenuUser">
        <allowColonistLikeFloatMenu>true</allowColonistLikeFloatMenu>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_GravshipPilotUser">
        <allowGravshipPilotConsole>true</allowGravshipPilotConsole>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_DirectedSocialInteractionUser">
        <ensureInteractionsTracker>true</ensureInteractionsTracker>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_MAPMechanitorTravelNode">
        <canLeadCaravan>true</canLeadCaravan>
        <canCollectCaravanItems>true</canCollectCaravanItems>
        <refreshTrackersOnTransporterArrival>true</refreshTrackersOnTransporterArrival>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_WorkTabVisibleUser">
        <showInWorkTab>true</showInWorkTab>
        <ensureWorkSettings>true</ensureWorkSettings>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_PsychicRitualParticipantUser">
        <allowPsychicRituals>true</allowPsychicRituals>
        <allowInvoker>true</allowInvoker>
        <allowChanter>true</allowChanter>
        <allowChanterAdvanced>true</allowChanterAdvanced>
        <allowDefender>true</allowDefender>
        <allowTargetRoles>false</allowTargetRoles>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_MechanoidMechanitorSelfWorkModeUser" />
      <li Class="MAP_MechanoidMechanitor.CompProperties_EnsureEmptyGeneTracker" />
    </comps>
    <race>
      <mechFixedSkillLevel>12</mechFixedSkillLevel>
      <mechEnabledWorkTypes>
        <li>Firefighter</li> <!-- 灭火 -->
        <li>Patient</li> <!-- 病患 -->
        <li>Doctor</li> <!-- 医生 -->
        <li>PatientBedRest</li> <!-- 卧床 -->
        <li>BasicWorker</li> <!-- 杂项 -->
        <li>Warden</li> <!-- 监管 -->
        <li>Handling</li> <!-- 驯兽 -->
        <li>Cooking</li> <!-- 烹饪 -->
        <li>Hunting</li> <!-- 狩猎 -->
        <li>Construction</li> <!-- 建造 -->
        <li>Growing</li> <!-- 种植 -->
        <li>Mining</li> <!-- 采矿 -->
        <li>PlantCutting</li> <!-- 割除 -->
        <li>Smithing</li> <!-- 锻造 -->
        <li>Tailoring</li> <!-- 裁缝 -->
        <li>Art</li> <!-- 艺术 -->
        <li>Crafting</li> <!-- 制作 -->
        <li>Hauling</li> <!-- 搬运 -->
        <li>Cleaning</li> <!-- 清洁 -->
        <li>Research</li> <!-- 研究 -->
        <li>Childcare</li> <!-- 育儿 -->
        <li MayRequire="Ludeon.RimWorld.Anomaly">DarkStudy</li> <!-- 诡异调查 -->
        <li MayRequire="Ludeon.RimWorld.Odyssey">Fishing</li> <!-- 钓鱼 -->
      </mechEnabledWorkTypes>
    </race>
  </ThingDef>

  <PawnKindDef ParentName="MAP_JusticeKindBase">
