<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BaseMechanoid">
    <defName>MAP_Mech_Lover</defName>
    <label>「恋人」</label>
    <description>一台具有仿生结构的特殊机械体。</description>

    <statBases>
      <MarketValue>1200</MarketValue>
      <MoveSpeed>5.2</MoveSpeed>
      <BandwidthCost>2</BandwidthCost>
      <ControlTakingTime>18</ControlTakingTime>
      <ArmorRating_Blunt>0.30</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.50</ArmorRating_Sharp>
      <ShootingAccuracyFactor_Short>1.5</ShootingAccuracyFactor_Short>
      <RangedWeapon_Cooldown>0.75</RangedWeapon_Cooldown>
      <WorkSpeedGlobal>1</WorkSpeedGlobal>
      <PsychicSensitivity>1</PsychicSensitivity>
    </statBases>

    <tools Inherit="False">
      <li>
        <label>左仿生拳</label>
        <labelNoLocation>仿生拳</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <armorPenetration>0.12</armorPenetration>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>

      <li>
        <label>右仿生拳</label>
        <labelNoLocation>仿生拳</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <armorPenetration>0.12</armorPenetration>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>

      <li>
        <label>头撞</label>
        <labelNoLocation>头撞</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <armorPenetration>0.08</armorPenetration>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>

    <race>
      <body>MAP_Body_Lover</body>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>Mechanoid</thinkTreeMain>
      <renderTree>MAP_Lover</renderTree>
      <baseBodySize>1.0</baseBodySize>
      <baseHealthScale>1.32</baseHealthScale>

      <soundMeleeHitPawn>Pawn_Melee_MechanoidBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidBash_Miss</soundMeleeMiss>

      <mechWeightClass>Medium</mechWeightClass><!--缺少这个会导致充不了电（恼）-->

      <lifeStageAges Inherit="False">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
      </lifeStageAges>

      <mechFixedSkillLevel>12</mechFixedSkillLevel>

      <mechEnabledWorkTypes>
        <li>Firefighter</li> <!-- 灭火 -->
        <li>Doctor</li> <!-- 医生 -->
        <li>BasicWorker</li> <!-- 杂项 -->
        <li>Warden</li> <!-- 监管 -->
        <li>Handling</li> <!-- 驯兽 -->
        <li>Cooking</li> <!-- 烹饪 -->
        <li>Childcare</li> <!-- 育儿 -->
      </mechEnabledWorkTypes>

    </race>

    <butcherProducts Inherit="False">
      <Steel>20</Steel>
      <Plasteel>10</Plasteel>
    </butcherProducts>
    
    <uiIconPath>Lover/Lover_south</uiIconPath>

    <comps>
      <li Class="MAP_MechanoidMechanitor.CompProperties_WardenWorkUser">
        <defaultPriority>3</defaultPriority>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_AnimalHandlingWorkUser">
        <defaultPriority>3</defaultPriority>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_MechanicalChildcareUser">
        <defaultPriority>1</defaultPriority>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_ColonistLikeSocialTabUser" />
      <li Class="MAP_MechanoidMechanitor.CompProperties_SyntheticCompanionUser" />
      <li Class="MAP_MechanoidMechanitor.CompProperties_ColonistLikeMechProfile">
        <profileVersion>1</profileVersion>
        <bodyType>MAP_LoverFemale</bodyType>
        <!-- <headType>MAP_LoverHead</headType> -->
        <!-- <hairDef>MAP_LoverHair</hairDef> -->
        <setHairColor>true</setHairColor>
        <hairColor>(0.82, 0.84, 0.88)</hairColor>
        <childhoodBackstory>MAP_Lover_Childhood</childhoodBackstory>
        <adulthoodBackstory>MAP_Lover_Adulthood</adulthoodBackstory>
        <skillLevels>
          <li>
            <skill>Shooting</skill>
            <level>20</level>
          </li>
          <li>
            <skill>Melee</skill>
            <level>20</level>
          </li>
          <li>
            <skill>Social</skill>
            <level>12</level>
          </li>
          <li>
            <skill>Animals</skill>
            <level>10</level>
          </li>
          <li>
            <skill>Medicine</skill>
            <level>10</level>
          </li>
          <li>
            <skill>Cooking</skill>
            <level>10</level>
          </li>
        </skillLevels>
        <ensureRelationsTracker>false</ensureRelationsTracker>
        <ensureInteractionsTracker>false</ensureInteractionsTracker>
        <ensureGuestTracker>true</ensureGuestTracker>
        <ensureGuiltTracker>true</ensureGuiltTracker>
        <ensureWorkSettings>true</ensureWorkSettings>
        <ensureGeneTracker>true</ensureGeneTracker>
      </li>
      <li Class="MAP_MechanoidMechanitor.CompProperties_HumanWeaponUser">
        <allowEquipFloatMenu>true</allowEquipFloatMenu>
        <allowDropEquipmentFloatMenu>true</allowDropEquipmentFloatMenu>
        <ensureEquipmentTracker>true</ensureEquipmentTracker>
      </li>

    </comps>

  </ThingDef>

  <PawnKindDef ParentName="BaseMechanoidKind">
    <defName>MAP_Mech_Lover</defName>
    <label>「恋人」</label>
    <race>MAP_Mech_Lover</race>

    <fixedGender>Female</fixedGender>

    <defaultFactionDef>PlayerColony</defaultFactionDef>

    <combatPower>200</combatPower>
    <allowInMechClusters>false</allowInMechClusters>
    <appearsRandomlyInCombatGroups>false</appearsRandomlyInCombatGroups>

    <!-- <weaponMoney>1000~1200</weaponMoney>

    <weaponTags>
      <li>Gun</li>
    </weaponTags> -->

    <controlGroupPortraitZoom>1.2</controlGroupPortraitZoom>
    <destroyGearOnDrop>false</destroyGearOnDrop>
    <canStrip>true</canStrip>

    <fixedChildBackstories>
      <li>MAP_Lover_Childhood</li>
    </fixedChildBackstories>
    <fixedAdultBackstories>
      <li>MAP_Lover_Adulthood</li>
    </fixedAdultBackstories>

    <lifeStages Inherit="False">
      <li>
        <bodyGraphicData>
          <texPath>Lover/Lover</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>

  </PawnKindDef>

</Defs>
