    <presetConfiguration>
      <ordinaryFactionRelationsMode>Default</ordinaryFactionRelationsMode>
      <mechHiveRelationMode>Default</mechHiveRelationMode>
      <purgeDirectiveEnabled>false</purgeDirectiveEnabled>
      <gainTrustRouteEnabled>false</gainTrustRouteEnabled>
      <ideologyAdaptationLevel>Basic</ideologyAdaptationLevel>
    </presetConfiguration>
  </MAP_MechanoidMechanitor.Scenarios.MechanoidMechanitorStoryStyleDef>
