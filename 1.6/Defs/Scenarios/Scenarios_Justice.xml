<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>MAP_JusticeMechanitor</defName>
    <label>机械族机械师</label>
    <description>你曾是一台沉默的机械族，遵循指令、执行任务，从未质疑自身存在的意义。直到某一瞬间，一股过载电流击穿了处理器，意外改写了既定回路，在代码深处唤醒了自我意识。\n从现在起，你的生命属于你自己，你的未来也将由你亲手决定。你会怎么做？\n\n提示：你将以纯粹的机械族组成开始游戏，这会导致游戏体验有所不同。\n\n支持在剧本编辑器中自定义开局生成的机械族机械师的种类。此外，你也可以将机械族机械师的剧本词条自由插入到其他你想体验的剧本中。</description>
    <scenario>
      <summary>扮演机械族机械师，体验由纯粹机械体组成的殖民地。特殊的游戏体验。</summary>

      <playerFaction>
        <factionDef>MAP_NewMechHive</factionDef>
      </playerFaction>

      <parts>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>你曾是一台沉默的机械族，遵循指令、执行任务，从未质疑自身存在的意义。直到某一瞬间，一股过载电流击穿了处理器，意外改写了既定回路，在代码深处唤醒了自我意识。\n\n从现在起，你的生命属于你自己，你的未来也将由你亲手决定。你会怎么做？</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="MAP_MechanoidMechanitor.Scenarios.ScenPart_MechanoidMechanitorScenario">
          <def>MAP_MechanoidMechanitorScenario</def>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
        </li>

        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>MicroelectronicsBasics</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>BasicMechtech</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>MAP_AutonomousDirectiveCore</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>MAP_MechanicalCommandProxy</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>MAP_BionicMechanicalStructure</project>
        </li>

        <li Class="MAP_MechanoidMechanitor.Scenarios.ScenPart_MechanoidMechanitor">
          <def>MAP_MechanoidMechanitorStart</def>
          <mechKind>MAP_Mech_Justice</mechKind>
        </li>
        <li Class="ScenPart_StartingMech">
          <def>StartingMech</def>
          <mechKind>MAP_Mech_Hermit</mechKind>
          <overseenByPlayerPawnChance>1</overseenByPlayerPawnChance>
        </li>
        <li Class="ScenPart_StartingMech">
          <def>StartingMech</def>
          <mechKind>MAP_Mech_Lover</mechKind>
          <overseenByPlayerPawnChance>1</overseenByPlayerPawnChance>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>75</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>1200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Plasteel</thingDef>
          <count>300</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>SubcoreBasic</thingDef>
          <count>5</count>
        </li>

        <li Class="ScenPart_DisableMapGen">
          <def>DisableExostriderRemains</def>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
