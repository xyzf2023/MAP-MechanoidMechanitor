<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>MAP_MechOverheating</defName>
    <label>机体过热</label>
    <description>大量热量导致的机械族运行受到干扰。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <defaultLabelColor>(1.0, 0.5, 0.0)</defaultLabelColor>
    <initialSeverity>0</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <lethalSeverity>1</lethalSeverity>
    <!-- 保护停机由能力下降触发倒地，不启用能力变化导致的随机倒地死亡。 -->
    <canApplyDodChanceForCapacityChanges>false</canApplyDodChanceForCapacityChanges>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <!-- 原版每天 60000 tick；每 200 tick 降低约 0.033333，平均每 60 tick 降低 0.01。 -->
        <severityPerDay>-10</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>热量积聚</label>
        <minSeverity>0</minSeverity>
        <becomeVisible>true</becomeVisible>
      </li>
      <li>
        <label>轻微过热</label>
        <minSeverity>0.05</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.95</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <label>散热过载</label>
        <minSeverity>0.2</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.85</postFactor>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.9</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <label>热失衡</label>
        <minSeverity>0.4</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.65</postFactor>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.75</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <label>保护停机</label>
        <minSeverity>0.7</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
