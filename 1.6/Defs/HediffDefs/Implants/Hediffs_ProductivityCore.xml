<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_ProductivityCore</defName>
    <hediffClass>Hediff_Level</hediffClass>
    <descriptionHyperlinks>
      <ThingDef>MAP_EfficiencyCoreQuantumComputingArray</ThingDef>
      <ThingDef>MAP_EfficiencyCoreMemoryExpansion</ThingDef>
    </descriptionHyperlinks>
    <label>效能核心</label>
    <description>一套可植入机械师的微型量子运算阵列，能为受监管机械族实时计算最优作业方案。\n\n大幅提高该机械师监管机械族的工作速度与制作品质，移除机械族进行工作时的技能限制，阻止因烹饪等级造成的食物中毒，并使手术一定成功。可通过内存拓展模块提升至最高5级。</description>
    <descriptionShort>该机械师监管的机械族工作效率与质量大幅提升。</descriptionShort>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>5</maxSeverity>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <levelIsQuantity>true</levelIsQuantity>
    <comps>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_ProductivityCore"/>
    </comps>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
      </li>
    </stages>
    <duplicationAllowed>false</duplicationAllowed>
  </HediffDef>

  <HediffDef MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_ProductivityCoreActive</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>效能核心生效中</label>
    <description>由监管者的效能核心提供的状态，可以显著提升该机械族的工作效率，且效能核心每级都会为该机械族提供制作物品质量偏移+1的效果。同时，该机械族进行工作不会受到技能限制，其烹饪的食物不会因为厨艺不足而导致食物中毒，进行的手术也一定成功。</description>
    <descriptionShort>效能核心正在提高该机械族的工作效率与工作质量。</descriptionShort>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <levelIsQuantity>false</levelIsQuantity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
      </li>
    </stages>
    <duplicationAllowed>false</duplicationAllowed>
  </HediffDef>
</Defs>
