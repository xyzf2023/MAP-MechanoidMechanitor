<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_VoidEngine</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <descriptionHyperlinks>
      <ThingDef>MAP_VoidEngine</ThingDef>
    </descriptionHyperlinks>
    <label>虚空引擎</label>
    <description>一种能够稳定微型虚空泡，并从量子真空中持续汲取能量的机械师植入体。它会通过监管链路为受监管机械族的反应堆供能，使其停止日常能量消耗、避免因机体受损而损失能量，并缓慢恢复能量储备。</description>
    <descriptionShort>该机械师监管的机械族可以实现自供能。</descriptionShort>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <levelIsQuantity>false</levelIsQuantity>
    <comps>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_VoidEngine"/>
    </comps>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statFactors>
          <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
          <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
        </statFactors>
      </li>
    </stages>
    <duplicationAllowed>false</duplicationAllowed>
  </HediffDef>

  <HediffDef MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_ReactorSelfPowering</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>反应堆自供能</label>
    <description>虚空引擎正在引导机械族从虚空泡中汲取能量。</description>
    <descriptionShort>机械族反应堆自供能系统。</descriptionShort>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <levelIsQuantity>false</levelIsQuantity>
    <comps>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_PeriodicEnergyRestore">
        <intervalTicks>2500</intervalTicks>
        <restoreFraction>0.002</restoreFraction>
      </li>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_ExtraEffectDescription">
        <providers>
          <li Class="MAP_MechanoidMechanitor.HediffExtraDescriptionProvider_PeriodicEnergyRestore" />
        </providers>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statFactors>
          <MechEnergyUsageFactor>0.25</MechEnergyUsageFactor>
          <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
        </statFactors>
      </li>
    </stages>
    <duplicationAllowed>false</duplicationAllowed>
  </HediffDef>
</Defs>
