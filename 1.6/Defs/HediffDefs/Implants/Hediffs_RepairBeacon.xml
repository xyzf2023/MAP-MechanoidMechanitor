<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_RepairBeacon</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <descriptionHyperlinks>
      <ThingDef>MAP_RepairBeacon</ThingDef>
    </descriptionHyperlinks>
    <label>修复信标</label>
    <description>一种内置量子结构演算阵列的机械师植入体。它能持续解析受监管机械族的结构损伤，并通过监管链路下发精确的自我修复序列；必要时还可超负荷运行，启动战地修复协议。</description>
    <descriptionShort>该机械师可以引导受监管机械族进行自我修复。需要打开自动修复。</descriptionShort>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <levelIsQuantity>false</levelIsQuantity>
    <comps>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_RepairBeacon"/>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>MAP_BattlefieldRepairProtocol</li>
        </abilityDefs>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
      </li>
    </stages>
    <duplicationAllowed>false</duplicationAllowed>
  </HediffDef>

  <HediffDef MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_RepairBoost</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>修复信标生效中</label>
    <description>修复信标正在引导机械族执行自我修复。</description>
    <descriptionShort>修复信标正在引导自我修复。</descriptionShort>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <levelIsQuantity>false</levelIsQuantity>
    <comps>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_MechRepair">
        <repairIntervalTicks>120</repairIntervalTicks>
        <repairAmount>10</repairAmount>
        <requiresAutoRepair>true</requiresAutoRepair>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
      </li>
    </stages>
    <duplicationAllowed>false</duplicationAllowed>
  </HediffDef>

  <HediffDef MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_BeaconRepairGuidance</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>信标修复引导</label>
    <description>机械师正在引导机械族进行高强度自我修复，因此受到了一定程度的干扰。</description>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <duplicationAllowed>false</duplicationAllowed>
  </HediffDef>

  <HediffDef MayRequire="ludeon.rimworld.biotech">
    <defName>MAP_BattlefieldRepairProtocolActive</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>战地修复协议生效中</label>
    <description>修复信标正在以超负荷模式引导机械族进行快速自我修复。</description>
    <descriptionShort>正在进行快速自我修复。</descriptionShort>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <levelIsQuantity>false</levelIsQuantity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_MechRepair">
        <repairIntervalTicks>6</repairIntervalTicks>
        <repairAmount>10</repairAmount>
        <requiresAutoRepair>false</requiresAutoRepair>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
      </li>
    </stages>
    <duplicationAllowed>false</duplicationAllowed>
  </HediffDef>
</Defs>
