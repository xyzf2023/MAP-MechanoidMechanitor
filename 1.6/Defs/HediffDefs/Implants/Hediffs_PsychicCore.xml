<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef MayRequire="ludeon.rimworld.biotech,ludeon.rimworld.royalty">
    <defName>MAP_PsychicCore</defName>
    <hediffClass>MAP_MechanoidMechanitor.Hediff_PsychicCore</hediffClass>
    <descriptionHyperlinks>
      <ThingDef>MAP_PsychicCore</ThingDef>
    </descriptionHyperlinks>
    <label>心灵中枢</label>
    <description>一种以启灵装置为核心构筑的精密植入体。在保留启灵装置原有功能的基础上，它能够进一步稳定并强化灵能通路，从多个方面提升使用者的灵能能力。\n\n此装置同样能够为机械族机械师提供启灵等级。</description>
    <descriptionShort>该单位的心灵能力获得了强化。强化效果随植入数量提升。</descriptionShort>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>1</minSeverity>
    <maxSeverity>10</maxSeverity>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <levelIsQuantity>false</levelIsQuantity>
    <duplicationAllowed>false</duplicationAllowed>
    <comps>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>MAP_PsychicActivation</li>
        </abilityDefs>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statOffsets><PsychicSensitivity>0.25</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.90</PsychicEntropyGain></statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statOffsets><PsychicSensitivity>0.50</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.85</PsychicEntropyGain></statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statOffsets><PsychicSensitivity>0.75</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.80</PsychicEntropyGain></statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <statOffsets><PsychicSensitivity>1.00</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.75</PsychicEntropyGain></statFactors>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <statOffsets><PsychicSensitivity>1.50</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.70</PsychicEntropyGain></statFactors>
      </li>
      <li>
        <minSeverity>6</minSeverity>
        <statOffsets><PsychicSensitivity>2.00</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.65</PsychicEntropyGain></statFactors>
      </li>
      <li>
        <minSeverity>7</minSeverity>
        <statOffsets><PsychicSensitivity>2.75</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.55</PsychicEntropyGain></statFactors>
      </li>
      <li>
        <minSeverity>8</minSeverity>
        <statOffsets><PsychicSensitivity>3.50</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.45</PsychicEntropyGain></statFactors>
      </li>
      <li>
        <minSeverity>9</minSeverity>
        <statOffsets><PsychicSensitivity>4.25</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.30</PsychicEntropyGain></statFactors>
      </li>
      <li>
        <minSeverity>10</minSeverity>
        <statOffsets><PsychicSensitivity>5.00</PsychicSensitivity></statOffsets>
        <statFactors><PsychicEntropyGain>0.15</PsychicEntropyGain></statFactors>
        <blocksMentalBreaks>true</blocksMentalBreaks>
      </li>
    </stages>
  </HediffDef>

  <HediffDef MayRequire="ludeon.rimworld.biotech,ludeon.rimworld.royalty">
    <defName>MAP_PsychicActivationActive</defName>
    <hediffClass>MAP_MechanoidMechanitor.Hediff_PsychicActivationActive</hediffClass>
    <label>心灵活化</label>
    <description>该单位的心灵能力被激活，灵能通路在短时间内进入高度活跃状态。\n\n持续期间使用者的灵能将得到进一步强化，并获得额外的精神力恢复能力。\n额外恢复效果随心灵中枢等级提升而提升。效果持续六个小时。</description>
    <descriptionShort>该单位的心灵能力处于活化状态。</descriptionShort>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <duplicationAllowed>false</duplicationAllowed>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statFactors>
          <PsychicSensitivity>2.00</PsychicSensitivity>
          <PsychicEntropyGain>0</PsychicEntropyGain>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
