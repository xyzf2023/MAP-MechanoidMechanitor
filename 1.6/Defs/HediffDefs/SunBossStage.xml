<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>MAP_SunBossStage</defName>
    <label>「太阳」- 能源核心</label>
    <description>「太阳」核心反应堆当前的运行状态。周围的稳定器持续约束反应堆内狂暴的能量，随着稳定器被摧毁，反应堆的运行状态将不断恶化。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.5, 0.0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>7</initialSeverity>
    <maxSeverity>7</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_ExtraEffectDescription">
        <providers>
          <li Class="MAP_MechanoidMechanitor.HediffExtraDescriptionProvider_SunBossStage" />
        </providers>
      </li>
    </comps>
    <stages>
      <li>
        <label>结构崩解</label>
        <minSeverity>0</minSeverity>
        <statOffsets><MoveSpeed>-0.5</MoveSpeed></statOffsets>
      </li>
      <li>
        <label>核心失稳</label>
        <minSeverity>2</minSeverity>
        <statOffsets><MoveSpeed>-0.25</MoveSpeed></statOffsets>
      </li>
      <li><label>稳态临界</label><minSeverity>3</minSeverity></li>
      <li><label>反馈失谐</label><minSeverity>4</minSeverity></li>
      <li><label>负载波动</label><minSeverity>5</minSeverity></li>
      <li>
        <label>稳态受扰</label>
        <minSeverity>6</minSeverity>
        <statOffsets><MoveSpeed>0.5</MoveSpeed></statOffsets>
      </li>
      <li>
        <label>完全稳态</label>
        <minSeverity>7</minSeverity>
        <statOffsets><MoveSpeed>1</MoveSpeed></statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
