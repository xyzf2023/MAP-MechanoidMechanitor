<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<HediffDef>
    <defName>MAP_MechanoidMechanitor_SelfWorkMode_AutonomousDirective</defName>
    <label>自律指令</label>
    <description>机械族机械师本体进入自律执行状态，可进行自我维护并映射为自动工作行为。</description>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_MechanoidMechanitorModeRecovery">
        <repairInterval>600</repairInterval>
        <repairAmount>10</repairAmount>
        <energyRestoreInterval>300</energyRestoreInterval>
        <energyRestoreFraction>0.01</energyRestoreFraction>
        <showRecoveryRates>true</showRecoveryRates>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MAP_MechanoidMechanitor_SelfWorkMode_SelfRepair</defName>
    <label>自我修复</label>
    <description>该机械族正处于休眠状态，其自我修复组件正在快速修复其受损部位。</description>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="MAP_MechanoidMechanitor.HediffCompProperties_MechanoidMechanitorModeRecovery">
        <repairInterval>60</repairInterval>
        <repairAmount>30</repairAmount>
        <energyRestoreInterval>300</energyRestoreInterval>
        <energyRestoreFraction>0.01</energyRestoreFraction>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
