<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>MAP_GravityDisorder</defName>
    <label>重力紊乱</label>
    <description>由魔术师施加的重力紊乱状态。该单位身边的重力场十分不稳定，无法正常行动。</description>
    <descriptionShort>该单位因重力场变化而无法进行任何行为。</descriptionShort>
    <hediffClass>MAP_MechanoidMechanitor.Hediff_GravityDisorder</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <blocksSocialInteraction>true</blocksSocialInteraction>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
