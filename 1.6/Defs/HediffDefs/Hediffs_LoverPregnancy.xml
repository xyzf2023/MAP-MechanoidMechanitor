<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>MAP_LoverPregnant</defName>
    <label>怀孕</label>
    <description>一个由「恋人」孕育的新生命正在成长。</description>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <hediffClass>MAP_MechanoidMechanitor.Hediff_LoverPregnant</hediffClass>
    <initialSeverity>0.001</initialSeverity>
    <isBad>false</isBad>
    <pregnant>true</pregnant>
    <preventsPregnancy>true</preventsPregnancy>
    <comps>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <label>早期</label>
      </li>
      <li>
        <label>中期</label>
        <minSeverity>0.333</minSeverity>
      </li>
      <li>
        <label>晚期</label>
        <minSeverity>0.666</minSeverity>
      </li>
    </stages>
    <modExtensions>
      <li Class="MAP_MechanoidMechanitor.HediffDefExtension_LoverPregnancy">
        <gestationDays>18</gestationDays>
      </li>
    </modExtensions>
  </HediffDef>

  <HediffDef>
    <defName>MAP_ExtraordinaryOffspring</defName>
    <label>超凡子嗣</label>
    <description>该人类由「恋人」孕育，拥有更强的身体素质。</description>
    <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li />
    </stages>
  </HediffDef>
</Defs>
